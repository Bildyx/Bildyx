@model MayGraphCards.Models.ProductCardModel
@using System
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Model.BaseHref" />
    <meta charset="UTF-8">
    <title>@Model.NameOfProduct - Card</title>
        <style>

        @@font-face { font-family: 'Bebas Neue Pro'; src: url('Fonts/BebasNeuePro-Bold.woff2') format('woff2'); font-weight: bold; }
        @@font-face { font-family: 'Work Sans'; src: url('Fonts/WorkSans-Regular.woff2') format('woff2'); }
        html, body { width: 500px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header-row { display: flex; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
        .header { display: flex; border-radius: 30px; border: 3px solid #396bb3; padding: 5px 10px; justify-content: center; width: 100%; }
        .maygraph-logo { display: flex; align-items: center; }
        .maygraph-logo img { height: 80px; object-fit: contain; }
        .product-title { font-family: 'Bebas Neue Pro', sans-serif; font-size: 1.8rem; color: #1d1d1b; font-weight: bold; letter-spacing: 1px; display: flex; align-items: center; text-align: center; gap: 15px; justify-content: center; }
        .product-title img { width: 40px; }
        .type-primary { color: #104589; font-weight: 700; font-size: 1.25rem; text-align: center; margin-bottom: 10px; }
        .info-table { display: flex; flex-direction: column; gap: 15px; padding: 0px 20px; }
        .info-row { display: flex; align-items: center; gap: 14px; }
        .info-icon { display: flex; align-items: center; justify-content: center; background: none; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-label { flex: 1 1 130px; font-size: 1.10rem; color: #090b28; font-weight: 500; letter-spacing: 0.02em; }
        .info-value { flex: 1.1 1 180px; text-align: left; color: #00448c; font-size: 1.12rem; font-weight: 500; word-break: break-word; letter-spacing: 0.01em; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 15px; padding: 0px 20px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
            .header-icon { display: none; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="Images/logos/Logo-MayGraph_Big1.png" />
            </div>
            <div class="header">
                <div class="product-title">@Model.NameOfProduct</div>
            </div>
            <div class="header-icon">
                <img src="Images/icons/product.png" />
            </div>
        </div>
        @if (!String.IsNullOrWhiteSpace(Model.Type))
        {
            <div class="type-primary">@Model.Type</div>
        }
        <div class="info-table">
            @if (!String.IsNullOrWhiteSpace(Model.Company))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/building.png" />
                    </div>
                    <div class="info-label">Company</div>
                    <div class="info-value">@Model.Company</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.ProductType))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/product_branch.png" />
                    </div>
                    <div class="info-label">Product Type</div>
                    <div class="info-value">@Model.ProductType</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/product_note.png" />
                    </div>
                    <div class="info-label">Description</div>
                    <div class="info-value">@Model.Description</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Industries))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/industry.png" />
                    </div>
                    <div class="info-label">Industries</div>
                    <div class="info-value">@Model.Industries</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Competitors))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/battle.png" />
                    </div>
                    <div class="info-label">Competitors</div>
                    <div class="info-value">@Model.Competitors</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.FunFact))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/notes.png" />
                    </div>
                    <div class="info-label">Fun Fact</div>
                    <div class="info-value">@Model.FunFact</div>
                </div>
            }
        </div>
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.SerialNumber}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>