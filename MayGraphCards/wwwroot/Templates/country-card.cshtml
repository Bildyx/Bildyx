                    <div class="info-label">Number Of Foreign Companies That Have Office</div>
                    <div class="info-value">@Model.NumberOfForeignCompaniesThatHaveOffice</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.NumberOfTourists))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/tourist.png" /></div>
                    <div class="info-label">Number Of Tourists</div>
                    <div class="info-value">@Model.NumberOfTourists</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.NumberOfAirports))
            {
