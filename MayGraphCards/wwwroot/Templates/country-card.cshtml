            @if (!String.IsNullOrWhiteSpace(Model.QualityOfPrimaryAndSecondaryEducation))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/quality.png" /></div>
                    <div class="info-label">Quality Of Primary And Secondary Education</div>
                    <div class="info-value">@Model.QualityOfPrimaryAndSecondaryEducation</div>
                </div>
