                }
                @if (!String.IsNullOrWhiteSpace(Model.MedianHomePrice))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/home_price.png" /></div>
                        <div class="info-label">Median Home Price</div>
                        <div class="info-value">@Model.MedianHomePrice</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.AverageRent))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/rent.png" /></div>
                        <div class="info-label">Average Rent</div>
                        <div class="info-value">@Model.AverageRent</div>
                    </div>
                }
            }
        </div>
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.CountryName}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>
