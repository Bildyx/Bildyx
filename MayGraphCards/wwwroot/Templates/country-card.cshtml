            }
            @if (!String.IsNullOrWhiteSpace(Model.Languages))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/language.png" /></div>
                    <div class="info-label">Languages</div>
                    <div class="info-value">@Model.Languages</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Religion))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/religion.png" /></div>
                    <div class="info-label">Religion</div>
                    <div class="info-value">@Model.Religion</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.CulturalValues))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/values.png" /></div>
                    <div class="info-label">Cultural Values</div>
                    <div class="info-value">@Model.CulturalValues</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.PeopleDescription))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/notes.png" /></div>
                    <div class="info-label">People Description</div>
                    <div class="info-value">@Model.PeopleDescription</div>
                </div>
            }
            @if (Model.IsExtended)
            {
                @if (!String.IsNullOrWhiteSpace(Model.Currency))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/currency.png" /></div>
                        <div class="info-label">Currency</div>
                        <div class="info-value">@Model.Currency</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.MainIndustries))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/industry.png" /></div>
                        <div class="info-label">Main Industries</div>
                        <div class="info-value">@Model.MainIndustries</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.LargestCompanies))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/big_companies.png" /></div>
                        <div class="info-label">Largest Companies</div>
                        <div class="info-value">@Model.LargestCompanies</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.NumberOfMultinationalHQs))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/hq.png" /></div>
                        <div class="info-label">Number Of Multinational HQs</div>
                        <div class="info-value">@Model.NumberOfMultinationalHQs</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.MedianSalary))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/salary_evolution.png" /></div>
                        <div class="info-label">Median Salary</div>
                        <div class="info-value">@Model.MedianSalary</div>
                    </div>
