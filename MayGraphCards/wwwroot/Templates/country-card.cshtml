                @if (!String.IsNullOrWhiteSpace(Model.PersonalIncomeTax))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/tax.png" /></div>
                        <div class="info-label">Personal Income Tax</div>
                        <div class="info-value">@Model.PersonalIncomeTax</div>
                    </div>
                }
                @if (!String.IsNullOrWhiteSpace(Model.CostOfLiving))
                {
                    <div class="info-row">
                        <div class="info-icon"><img src="Images/icons/living_cost.png" /></div>
                        <div class="info-label">Cost Of Living</div>
                        <div class="info-value">@Model.CostOfLiving</div>
