@model MayGraphCards.Models.JobCardModel
@using System
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Model.BaseHref" />
    <meta charset="UTF-8">
    <title>@Model.SerialNumber - Card</title>
        <style>

        @@font-face { font-family: 'Bebas Neue Pro'; src: url('Fonts/BebasNeuePro-Bold.woff2') format('woff2'); font-weight: bold; }
        @@font-face { font-family: 'Work Sans'; src: url('Fonts/WorkSans-Regular.woff2') format('woff2'); }
        html, body { width: 450px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; height: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header-row { display: flex; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
        .header { display: flex; border-radius: 30px; border: 3px solid #396bb3; padding: 5px 10px; justify-content: center; align-items: center; width: 100%; }
        .maygraph-logo { display: flex; align-items: center; }
        .maygraph-logo img { height: 80px; object-fit: contain; }
        .job-title { font-family: 'Bebas Neue Pro', sans-serif; font-size: 1.75rem; color: #1d1d1b; font-weight: bold; letter-spacing: 1px; display: flex; align-items: center; text-align: center; padding-left: 3px; }
        .job-title img { height: 30px; }
        .job-icon { display: flex; justify-content: center; margin-bottom: 10px; }
        .job-icon img { height: 90px; }
        .info-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
        .info-icon { display: flex; align-items: center; justify-content: center; }
        .info-icon img { width: 40px; object-fit: contain; }
        .info-block { display: flex; flex-direction: column; }
        .info-label { color: #090b28; font-size: 1rem; font-weight: 700; margin-bottom: 2px; }
        .info-value { color: #00448c; font-size: 1rem; font-weight: 500; word-break: break-word; }
        .footer-row { display: flex; justify-content: space-between; position: relative; padding: 0px 15px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="Images/logos/Logo-MayGraph_Big1.png" />
            </div>
            <div class="header">
                <div class="job-title">@($"What is a {Model.JobName}?")</div>
            </div>
        </div>
        <div class="job-icon">
            <img src="@($"Images/job-icons/{Model.JobNameSnakeCase}.png")" alt="@($"missing job-icons/{Model.JobNameSnakeCase}.png")" />
        </div>
        @if (!String.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="info-row">
                <span class="info-icon">
                    <img src="Images/icons/notes.png" />
                </span>
                <div class="info-block">
                    <span class="info-label">Description</span>
                    <span class="info-value">@Model.Description</span>
                </div>
            </div>
        }
        @if (!String.IsNullOrWhiteSpace(Model.Products))
        {
            <div class="info-row">
                <span class="info-icon">
                    <img src="Images/icons/product.png" />
                </span>
                <div class="info-block">
                    <span class="info-label">Products</span>
                    <span class="info-value">@Model.Products</span>
                </div>
            </div>
        }
        @if (!String.IsNullOrWhiteSpace(Model.ToolsAndTech))
        {
            <div class="info-row">
                <span class="info-icon">
                    <img src="Images/icons/tools_and_tech.png" />
                </span>
                <div class="info-block">
                    <span class="info-label">Tools and Tech</span>
                    <span class="info-value">@Model.ToolsAndTech</span>
                </div>
            </div>
        }
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.SerialNumber}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>