@model MayGraphCards.Models.CompanyCardModel
@using System
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Model.BaseHref" />
    <meta charset="UTF-8">
    <title>@Model.OrganizationName - Card</title>
        <style>

        @@font-face { font-family: 'Bebas Neue Pro'; src: url('Fonts/BebasNeuePro-Bold.woff2') format('woff2'); font-weight: bold; }
        @@font-face { font-family: 'Work Sans'; src: url('Fonts/WorkSans-Regular.woff2') format('woff2'); }
        html, body { width: 500px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header-row { display: flex; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
        .header { display: flex; border-radius: 30px; border: 3px solid #396bb3; padding: 5px 10px; justify-content: center; align-items: center; width: 100%; }
        .maygraph-logo { display: flex; align-items: center; }
        .maygraph-logo img { height: 80px; object-fit: contain; }
        .company-title { font-family: 'Bebas Neue Pro', sans-serif; font-size: 2.6rem; color: #1d1d1b; font-weight: bold; letter-spacing: 0.5px; margin-left: 0; }
        .type-primary { color: #104589; font-weight: 700; font-size: 1.25rem; text-align: center; margin: 10px 0px; }
        .info-table { display: flex; flex-direction: column; gap: 15px; padding: 0px 20px; }
        .info-row { display: flex; align-items: center; gap: 14px; }
        .info-icon { display: flex; align-items: center; justify-content: center; background: none; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-label { flex: 1 1 130px; font-size: 1.10rem; color: #090b28; font-weight: 500; letter-spacing: 0.02em; }
        .info-value { flex: 1.1 1 180px; text-align: left; color: #00448c; font-size: 1.12rem; font-weight: 500; word-break: break-word; letter-spacing: 0.01em; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 10px; margin-bottom: 2px; padding: 0px 20px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="Images/logos/Logo-MayGraph_Big1.png" />
            </div>
            <div class="header">
                <div class="company-title">@Model.OrganizationName</div>
            </div>
        </div>

        @if (!String.IsNullOrWhiteSpace(Model.Category))
        {
            <div class="type-primary">@Model.Category</div>
        }

        <div class="info-table">
            @if (!String.IsNullOrWhiteSpace(Model.Industry))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/industry.png" />
                    </div>
                    <div class="info-label">Industry</div>
                    <div class="info-value">@Model.Industry</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.CompanyType))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/type.png" />
                    </div>
                    <div class="info-label">Company Type</div>
                    <div class="info-value">@Model.CompanyType</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Founded))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/monument.png" />
                    </div>
                    <div class="info-label">Founded</div>
                    <div class="info-value">@Model.Founded</div>
                </div>
            }            
            @if (!String.IsNullOrWhiteSpace(Model.HeadquartersLocation))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/hq.png" />
                    </div>
                    <div class="info-label">Headquarters</div>
                    <div class="info-value">@Model.HeadquartersLocation</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Parent))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/parent_company.png" />
                    </div>
                    <div class="info-label">Parent Company</div>
                    <div class="info-value">@Model.Parent</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.NumberOfOffices))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/offices.png" />
                    </div>
                    <div class="info-label">No. of offices</div>
                    <div class="info-value">@Model.NumberOfOffices</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.NumberOfEmployees))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/employees.png" />
                    </div>
                    <div class="info-label">No. of employees</div>
                    <div class="info-value">@Model.NumberOfEmployees</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Products))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/product.png" />
                    </div>
                    <div class="info-label">Products</div>
                    <div class="info-value">@Model.Products</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.Subsidiaries))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/subsidiaries.png" />
                    </div>
                    <div class="info-label">Subsidiaries</div>
                    <div class="info-value">@Model.Subsidiaries</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.KnownFor))
            {
                <div class="info-row">
                    <div class="info-icon">
                        <img src="Images/icons/notes.png" />
                    </div>
                    <div class="info-label">Known for</div>
                    <div class="info-value">@Model.KnownFor</div>
                </div>
            }
        </div>
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.SerialNumber}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>