@model MayGraphCards.Models.IndustryCardModel
@using System
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Model.BaseHref" />
    <meta charset="UTF-8">
    <title>@Model.IndustryName - Card</title>
    <style>
        @@font-face {
            font-family: 'Bebas Neue Pro';
            src: url('Fonts/BebasNeuePro-Bold.woff2') format('woff2');
            font-weight: bold;
        }
        @@font-face {
            font-family: 'Work Sans';
            src: url('Fonts/WorkSans-Regular.woff2') format('woff2');
        }
        html, body { width: 500px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header { display: flex; align-items: center; gap: 18px; border-radius: 40px; border: 3px solid #396bb3; padding: 5px 10px; }
        .maygraph-logo img { width: 70px; height: 70px; object-fit: contain; padding: 4px; }
        .card-title { font-family: 'Bebas Neue Pro', sans-serif; font-size: 2.2rem; color: #1d1d1b; font-weight: bold; letter-spacing: 0.5px; }
        .info-table { display: flex; flex-direction: column; gap: 15px; padding: 15px 20px 5px; }
        .info-row { display: flex; align-items: center; gap: 14px; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-label { flex: 1 1 130px; font-size: 1.10rem; color: #090b28; font-weight: 500; }
        .info-value { flex: 1.1 1 180px; color: #00448c; font-size: 1.12rem; font-weight: 500; word-break: break-word; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 15px; padding: 0 20px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header">
            <div class="maygraph-logo"><img src="Images/logos/Logo-MayGraph_Big1.png" /></div>
            <div class="card-title">@Model.IndustryName</div>
        </div>
        <div class="info-table">
            @if (!String.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/notes.png" /></div>
                    <div class="info-label">Description</div>
                    <div class="info-value">@Model.Description</div>
                </div>
            }
            @if (!String.IsNullOrWhiteSpace(Model.MedianSalary))
            {
                <div class="info-row">
                    <div class="info-icon"><img src="Images/icons/salary_evolution.png" /></div>
                    <div class="info-label">Median Salary</div>
                    <div class="info-value">@Model.MedianSalary</div>
                </div>
            }
        </div>
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.SerialNumber}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>
