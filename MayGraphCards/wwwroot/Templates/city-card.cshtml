@model MayGraphCards.Models.CityCardModel
@using System
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Model.BaseHref" />
    <meta charset="UTF-8">
    <title>@Model.CityName - Card</title>
        <style>
        @@font-face {
            font-family: 'Bebas Neue Pro';
            src: url('Fonts/BebasNeuePro-Bold.woff2') format('woff2');
            font-weight: bold;
        }

        @@font-face {
            font-family: 'Work Sans';
            src: url('Fonts/WorkSans-Regular.woff2') format('woff2');
        }

        html, body {
            width: 1300px;
            margin: 0;
            padding: 0;
            font-family: 'Work Sans', Arial, sans-serif;
            background-color: transparent;
        }
        .main-card { width: 100%; background: #fdfdfd; border: 5px solid #396bb3; border-radius: 60px; padding: 40px 40px 34px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 5px solid #396bb3; pointer-events: none; }
        .header { display: flex; align-items: center; justify-content: center; padding: 0px 10px; }
        .company-logo { flex: 1; display: flex; justify-content: flex-start; } .company-logo img { height: 150px; }
        .city-image { flex: 1; display: flex; justify-content: center; } .city-image img { height: 150px; }
        .columns { display: flex; flex-direction: row; gap: 20px; margin-top: 5px; padding: 10px; }
        .col { flex: 1 1 0; display: flex; flex-direction: column; gap: 20px; min-width: 0; }
        .middle-col { justify-content: center; }
        .section { padding: 0px 15px 7px 15px; background: #f7fbff; border-radius: 34px; border: 3px solid #396bb3; }
        .section-title { font-size: 1.3rem; color: #f7fbff; letter-spacing: 0.5px; background: #396bb3; padding: 7px 22px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; margin: 0 -16px 16px -16px; text-align: center; display: inline-block; }
        .section-title-center { display: flex; justify-content: center; }
        .info-block { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
        .info-icon { width: 36px; height: 36px; background: none; display: flex; align-items: center; justify-content: center; } .info-icon img { width: 32px; height: 32px; object-fit: contain; }
        .info-label { color: #090b28; font-size: 1.09rem; font-weight: 500; flex: 1.3 1 80px; margin-right: 5px; }
        .info-value { color: #00448c; font-size: 1.12rem; font-weight: 500; flex: 2 1 140px; text-align: left; word-break: break-word; }
        .fact-block { background: #e5f1ff; border-radius: 16px; padding: 11px 13px 12px 13px; display: flex; align-items: flex-start; gap: 12px; margin-bottom: 8px; }
        .fact-value { color: #104589; font-size: 1.06rem; margin-top: 2px; }
        .people-desc { color: #1d1d1b; font-style: italic; font-size: 1.02rem; margin: 20px 0px 10px 0px; opacity: 0.9; text-align: center; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 5px; padding: 0px 20px; font-size: 1.8rem; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header">
            <div class="company-logo">
                <img src="Images/logos/Logo-MayGraph_Big1.png" />
            </div>
            <div class="city-image">
                <img src="@($"Images/city-banners/{Model.CityNameSnakeCase}.png")" alt="@($"missing city-banners/{Model.CityNameSnakeCase}.png")" />
            </div>
            <div style="flex: 1;"></div>
        </div>
        <div class="columns">
            <div class="col">
                @if (!String.IsNullOrWhiteSpace(Model.Population))
                {
                    <div class="section">
                        <div class="section-title-center">
                            <div class="section-title">General</div>
                        </div>
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/population.png" />
                            </span>
                            <span class="info-label">Population</span>
                            <span class="info-value">@Model.Population</span>
                        </div>
                    </div>
                }
                <div class="section">
                    <div class="section-title-center">
                        <div class="section-title">Economy and career</div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(Model.MainIndustries))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/industry.png" />
                            </span>
                            <span class="info-label">Main Industries</span>
                            <span class="info-value">@Model.MainIndustries</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.NumberOfMultinationalHQs))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/hq.png" />
                            </span>
                            <span class="info-label">No. of Multinational HQs</span>
                            <span class="info-value">@Model.NumberOfMultinationalHQs</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.NumberOfAirports))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/airport.png" />
                            </span>
                            <span class="info-label">No. of Airports</span>
                            <span class="info-value">@Model.NumberOfAirports</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.LargestCompanies))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/big_companies.png" />
                            </span>
                            <span class="info-label">Largest Companies</span>
                            <span class="info-value">@Model.LargestCompanies</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col middle-col">
                <div class="section">
                    <div class="section-title-center">
                        <div class="section-title">Housing & Income</div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(Model.MedianSalary))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/salary_evolution.png" />
                            </span>
                            <span class="info-label">Median Salary</span>
                            <span class="info-value">@Model.MedianSalary</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.CostOfLiving))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/living_cost.png" />
                            </span>
                            <span class="info-label">Cost of Living</span>
                            <span class="info-value">@Model.CostOfLiving</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.MedianHomePrice))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/home_price.png" />
                            </span>
                            <span class="info-label">Median Home Price</span>
                            <span class="info-value">@Model.MedianHomePrice</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.AverageRent))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/rent.png" />
                            </span>
                            <span class="info-label">Average Rent</span>
                            <span class="info-value">@Model.AverageRent</span>
                        </div>
                    }
                </div>
                <div class="section">
                    <div class="section-title-center">
                        <div class="section-title">Weather</div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(Model.Temperatures))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/temperature.png" />
                            </span>
                            <span style="font-size: 1rem;" class="info-label">Temperatures</span>
                            <span class="info-value">@Model.Temperatures</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.Climate))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/weather.png" />
                            </span>
                            <span class="info-label">Climate</span>
                            <span class="info-value">@Model.Climate</span>
                        </div>
                    }
                </div>
                @if (!String.IsNullOrWhiteSpace(Model.InterestingFact))
                {
                    <div class="section">
                        <div class="section-title-center">
                            <div class="section-title">Interesting fact</div>
                        </div>
                        <div class="fact-block">
                            <div class="fact-value">@Model.InterestingFact</div>
                        </div>
                    </div>
                }
            </div>
            <div class="col">
                <div class="section">
                    <div class="section-title-center">
                        <div class="section-title">Education</div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(Model.DegreeHolders))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/mortarboard.png" />
                            </span>
                            <span class="info-label">Degree Holders</span>
                            <span class="info-value">@Model.DegreeHolders</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.NumberOfCollegesAndUniversities))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/university.png" />
                            </span>
                            <span class="info-label">No. of Colleges and Universities</span>
                            <span class="info-value">@Model.NumberOfCollegesAndUniversities</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.TopUniversities))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/top_university.png" />
                            </span>
                            <span class="info-label">Top Univ.</span>
                            <span class="info-value">@Model.TopUniversities</span>
                        </div>
                    }
                </div>
                <div class="section">
                    <div class="section-title-center">
                        <div class="section-title">People</div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(Model.NumberOfNationalities))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/nationality.png" />
                            </span>
                            <span class="info-label">No. of Nationalities</span>
                            <span class="info-value">@Model.NumberOfNationalities</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.Languages))
                    {
                        <div class="info-block">
                            <span class="info-icon">
                                <img src="Images/icons/language.png" />
                            </span>
                            <span class="info-label">Languages</span>
                            <span class="info-value">@Model.Languages</span>
                        </div>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.PeopleDescription))
                    {
                        <div class="people-desc">@($"“{Model.PeopleDescription}”")</div>
                    }
                </div>
            </div>
        </div>
        <div class="footer-row">
            <span class="serial-number">@($"#{Model.SerialNumber}")</span>
            <span class="copyright">@($"©{DateTime.Now.Year}")</span>
        </div>
    </div>
</body>
</html>