# Copier en .env à la racine du dépôt et renseigner les valeurs.
# .env est ignoré par git (voir .gitignore).
#
# ATTENTION : le commit 9861ab8 (".env leak") a versionné un .env réel.
# Les secrets présents dans l'historique git doivent être considérés comme
# compromis et RÉVOQUÉS/RÉGÉNÉRÉS, même s'ils ont depuis été retirés de la
# copie de travail : mot de passe Postgres/Supabase, clé API Resend,
# GOOGLE_CLIENT_SECRET et SESSION_SECRET.

# Postgres via le pooler transactionnel (IPv4) - utilisé par l'application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Postgres via le pooler en mode session - utilisé par les migrations Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# SMTP (optionnel : sans ces valeurs, les mails sont écrits dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bildyx <onboarding@example.com>"

# URL de base des liens de réinitialisation de mot de passe
RESET_BASE_URL=http://localhost:5500/reset-password.html

PORT=3000
FRONTEND_URL=http://localhost:5500
BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
