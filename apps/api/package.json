{
  "name": "api",
  "version": "1.0.0",
  "description": "Bildyx Backend API",
  "main": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "kysely-codegen": "^0.20.0",
    "prisma": "^6.19.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@orpc/openapi": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/valibot": "^1.14.6",
    "@orpc/zod": "^1.14.6",
    "@prisma/client": "^6.19.0",
    "@scalar/express-api-reference": "^0.10.4",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kysely": "^0.29.2",
    "pg": "^8.22.0",
    "pretty-ms": "^9.3.0",
    "valibot": "^1.4.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "pretest": "tsx src/tests/generate-test-schema.ts",
    "test": "cross-env NODE_ENV=test tsx --import ./src/tests/setup.ts --test \"src/tests/**/*.test.ts\"",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:types": "kysely-codegen --out-file src/db/types.ts"
  }
}
