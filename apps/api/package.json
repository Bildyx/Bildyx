{
  "name": "api",
  "version": "1.0.0",
  "description": "Bildyx Backend API",
  "main": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.20.0",
    "prisma": "^6.19.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@orpc/openapi": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/valibot": "^1.14.6",
    "@orpc/zod": "^1.14.6",
    "@prisma/client": "^6.19.0",
    "@scalar/express-api-reference": "^0.10.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kysely": "^0.29.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pretty-ms": "^9.3.0",
    "valibot": "^1.4.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "seed": "tsx prisma/seed.ts",
    "pretest": "tsx -e \"import { execSync } from 'child_process'; import fs from 'fs'; fs.writeFileSync('src/tests/schema.sql', execSync('npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script', { encoding: 'utf-8' }));\"",
    "test": "tsx --import ./src/tests/setup.ts --test \"src/tests/**/*.test.ts\"",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:types": "kysely-codegen --out-file src/db/types.ts"
  }
}
