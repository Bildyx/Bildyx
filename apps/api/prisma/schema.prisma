// LAYER 1 : Cards

model Industry {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  serialNumber      String     @unique
  description       String?
  relatedIndustries Industry[] @relation("RelatedIndustries")
  relatedTo         Industry[] @relation("RelatedIndustries")
  iconUrl           String?    @map("icon_url")
  color             String?
  metadata          Json?
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  score             Int?

  jobs                  Job[]
  skills                Skill[]
  organizations         Organization[] @relation("OrganizationIndustries")
  products              Subject[]      @relation("ProductIndustries")
  mainIndustryCountries Country[]      @relation("CountryMainIndustries")
  mainIndustryCities    City[]         @relation("CityMainIndustries")

  @@map("industries")
}

model Country {
  id                            String          @id @default(uuid()) @db.Uuid
  name                          String
  serialNumber                  String          @unique
  isoCode                       String?         @unique @map("iso_code") @db.Char(2)
  capitalName                   String?         @map("capital_name")
  flagUrl                       String?         @map("flag_url")
  population                    BigInt?
  areaKm2                       Float?          @map("area_km2")
  gdpUsd                        Float?          @map("gdp_usd")
  gdpPerCapitaUsd               Float?          @map("gdp_per_capita_usd")
  hdi                           Float?
  currency                      String?
  officialLanguages             Language[]
  callingCode                   String?         @map("calling_code")
  governmentType                GovernmentType? @map("government_type")
  qualityOfLife                 QualityOfLife?  @map("quality_of_life")
  temperatures                  String?
  climate                       String?
  crimeRate                     String?         @map("crime_rate")
  incomeInequality              String?         @map("income_inequality")
  workLifeBalance               String?         @map("work_life_balance")
  mainIndustries                Industry[]      @relation("CountryMainIndustries")
  largestOrganizations          Organization[]  @relation("CountryLargestOrganizations")
  numberOfMultinationalHqs      Int?            @map("number_of_multinational_hqs")
  medianSalary                  Int?            @map("median_salary")
  costOfLiving                  CostOfLiving?   @map("cost_of_living")
  medianHomePrice               Int?            @map("median_home_price")
  averageRent                   Int?            @map("average_rent")
  interestingFact               String?         @map("interesting_fact")
  citizenshipProcess            String?         @map("citizenship_process")
  workPermit                    String?         @map("work_permit")
  globalCompetitivenessIndex    Int?            @map("global_competitiveness_index")
  levelOfGlobalisation          String?         @map("level_of_globalisation")
  numberOfInternationalStudents Int?            @map("number_of_international_students")
  numberOfForeignOrganizations  Int?            @map("number_of_foreign_organizations")
  personalIncomeTax             String?         @map("personal_income_tax")
  numberOfTourists              Int?            @map("number_of_tourists")
  numberOfAirports              Int?            @map("number_of_airports")
  qualityOfEducation            String?         @map("quality_of_education")
  degreeHolders                 String?         @map("degree_holders")
  numberOfUniversities          Int?            @map("number_of_universities")
  topUniversities               University[]    @relation("CountryTopUniversities")
  ethnicGroups                  String[]        @map("ethnic_groups")
  religion                      String[]
  culturalValues                String?         @map("cultural_values")
  peopleDescription             String?         @map("people_description")
  metadata                      Json?
  deletedAt                     DateTime?       @map("deleted_at")
  createdAt                     DateTime        @default(now()) @map("created_at")
  updatedAt                     DateTime        @updatedAt @map("updated_at")

  cities       City[]
  jobs         Job[]
  jobAds       JobAd[]
  degrees      Degree[]
  universities University[]
  userProfiles UserProfile[] @relation("UserProfileCountry")

  @@map("countries")
}

model City {
  id                       String         @id @default(uuid()) @db.Uuid
  name                     String
  serialNumber             String         @unique
  countryId                String         @map("country_id") @db.Uuid
  country                  Country        @relation(fields: [countryId], references: [id])
  isCapital                Boolean        @default(false) @map("is_capital")
  stateProvince            String?        @map("state_province")
  population               Int?
  mainIndustries           Industry[]     @relation("CityMainIndustries")
  numberOfMultinationalHqs Int?           @map("number_of_multinational_hqs")
  numberOfAirports         Int?           @map("number_of_airports")
  largestOrganizations     Organization[] @relation("CityLargestOrganizations")
  medianSalary             Int?           @map("median_salary")
  costOfLiving             CostOfLiving?  @map("cost_of_living")
  medianHomePrice          Int?           @map("median_home_price")
  averageRent              Int?           @map("average_rent")
  temperatures             String?
  climate                  String?
  interestingFact          String?        @map("interesting_fact")
  degreeHolders            String?        @map("degree_holders")
  numberOfUniversities     Int?           @map("number_of_universities")
  topUniversities          University[]   @relation("CityTopUniversities")
  numberOfNationalities    Int?           @map("number_of_nationalities")
  language                 Language?
  peopleDescription        String?        @map("people_description")
  latitude                 Float?
  longitude                Float?
  metadata                 Json?
  deletedAt                DateTime?      @map("deleted_at")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  universities             University[]
  jobAds                   JobAd[]
  userProfiles             UserProfile[]
  organizations            Organization[] @relation("OrganizationHeadquarters")
  workingAreaOrganizations Organization[] @relation("working_area")

  @@index([countryId])
  @@map("cities")
}

model Organization {
  id            String               @id @default(uuid()) @db.Uuid
  name          String
  slug          String               @unique
  type          OrganizationSubType?
  legalStatus   String?              @map("legal_status")
  category      String?
  ownership     String?
  mission       String?
  knownFor      String[]             @map("known_for")
  activities    String[]             @map("activities")
  project       String?              @map("project")
  researchAreas String[]             @map("research_areas")
  products      String[]
  services      String[]
  partnerships  String[]
  budget        String?
  founded       String?
  founder       String?
  equipments    String?
  score         Int?

  // Localisation
  headquarters City?  @relation("OrganizationHeadquarters", fields: [cityId], references: [id])
  workingArea  City[] @relation("working_area")

  // Taille & Effectifs
  numberOfEmployees    EmployeeCountRange?
  numberOfSubsidiaries Int?

  // Hiérarchie
  parentOrganizationId String?        @map("parent_organization_id") @db.Uuid
  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganization    Organization[] @relation("OrganizationHierarchy")

  metadata  Json?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  industries                   Industry[]      @relation("OrganizationIndustries")
  subjects                     Subject[]
  jobAds                       JobAd[]
  issuedCertifications         Certification[] @relation("CertificationIssuer")
  userProfiles                 UserProfile[]   @relation("UserCurrentOrganization")
  largestOrganizationCountries Country[]       @relation("CountryLargestOrganizations")
  largestOrganizationCities    City[]          @relation("CityLargestOrganizations")
  cityId                       String?         @db.Uuid

  @@index([parentOrganizationId])
  @@index([type])
  @@map("organizations")
}

model Job {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  serialNumber   String          @unique
  category       JobCategory?
  description    String?
  seniorityLevel SeniorityLevel? @map("seniority_level")
  isElected      Boolean         @default(false) @map("is_elected")
  isRegulated    Boolean         @default(false) @map("is_regulated")
  startYear      Int?            @map("start_year")
  industryId     String?         @map("industry_id") @db.Uuid
  industry       Industry?       @relation(fields: [industryId], references: [id])
  countryId      String?         @map("country_id") @db.Uuid
  country        Country?        @relation(fields: [countryId], references: [id])
  products       String[]
  toolsAndTech   String[]        @map("tools_and_tech")
  tags           String[]
  metadata       Json?
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  score          Int?

  jobAds       JobAd[]
  userProfiles UserProfile[] @relation("UserCurrentJob")

  @@index([industryId])
  @@index([countryId])
  @@index([category])
  @@index([seniorityLevel])
  @@map("jobs")
}

model Skill {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  serialNumber        String           @unique
  type                String?
  category            SkillCategory?
  categories          String[]
  description         String?
  iconUrl             String?          @map("icon_url")
  industryId          String?          @map("industry_id") @db.Uuid
  industry            Industry?        @relation(fields: [industryId], references: [id])
  difficulty          DifficultyLevel?
  usedIn              String[]         @map("used_in")
  jobs                String[]
  productCategories   String[]         @map("product_categories")
  commonFieldsOfStudy String[]         @map("common_fields_of_study")
  relatedAbilities    String[]         @map("related_abilities")
  timeToMaster        String?          @map("time_to_master")
  metadata            Json?
  deletedAt           DateTime?        @map("deleted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  score               Int?

  jobAdSkills JobAdSkill[]

  @@index([industryId])
  @@index([category])
  @@map("skills")
}

model Certification {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  serialNumber           String                 @unique
  issuingOrganizationId  String?                @map("issuing_organization_id") @db.Uuid
  issuingOrganization    Organization?          @relation("CertificationIssuer", fields: [issuingOrganizationId], references: [id])
  description            String?
  level                  String?
  category               CertificationCategory?
  products               String[]
  jobs                   String[]
  validityDurationMonths Int?                   @map("validity_duration_months")
  difficulty             DifficultyLevel?
  websiteUrl             String?                @map("website_url")
  metadata               Json?
  deletedAt              DateTime?              @map("deleted_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  score                  Int?

  @@index([issuingOrganizationId])
  @@index([category])
  @@map("certifications")
}

model University {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  serialNumber    String          @unique
  type            UniversityType?
  description     String?
  websiteUrl      String?         @map("website_url")
  logoUrl         String?         @map("logo_url")
  foundedYear     Int?            @map("founded_year")
  countryId       String?         @map("country_id") @db.Uuid
  country         Country?        @relation(fields: [countryId], references: [id])
  cityId          String?         @map("city_id") @db.Uuid
  city            City?           @relation(fields: [cityId], references: [id])
  isPublic        Boolean?        @map("is_public")
  studentCount    Int?            @map("student_count")
  metadata        Json?
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  scoreUniversity Float?          @map("score_university")
  localName       String?         @map("local_name")
  location        String?
  notes           String?
  established     String?
  score           Int?

  degrees        Degree[]
  topOfCities    City[]    @relation("CityTopUniversities")
  topOfCountries Country[] @relation("CountryTopUniversities")
  undergraduates Int?
  postgraduates  Int?

  @@index([countryId])
  @@index([cityId])
  @@index([type])
  @@map("universities")
}

model Degree {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  serialNumber          String       @unique
  universityId          String?      @map("university_id") @db.Uuid
  university            University?  @relation(fields: [universityId], references: [id]) // Pas toujours relié à une université mais possible
  level                 DegreeLevel?
  field                 String?
  durationYears         Float?       @map("duration_years")
  description           String?
  languageOfInstruction String?      @map("language_of_instruction")
  countryId             String?      @map("country_id") @db.Uuid
  country               Country?     @relation(fields: [countryId], references: [id])
  metadata              Json?
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  score                 Int?

  @@index([universityId])
  @@index([level])
  @@index([countryId])
  @@map("degrees")
}

/// Produit / Service / Solution
model Subject {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  serialNumber     String           @unique
  type             String?
  description      String?
  shortDescription String?          @map("short_description")
  category         SubjectCategory?
  competitors      String[]
  funFact          String?          @map("fun_fact")
  organizationId   String?          @map("organization_id") @db.Uuid
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  websiteUrl       String?          @map("website_url")
  logoUrl          String?          @map("logo_url")
  tags             String[]
  metadata         Json?
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  score            Int?

  industries Industry[] @relation("ProductIndustries")

  @@index([organizationId])
  @@index([category])
  @@map("products")
}

model JobAd {
  id                      String          @id @default(uuid()) @db.Uuid
  title                   String
  serialNumber            String          @unique
  organizationId          String          @map("organization_id") @db.Uuid
  organization            Organization    @relation(fields: [organizationId], references: [id])
  jobId                   String?         @map("job_id") @db.Uuid
  job                     Job?            @relation(fields: [jobId], references: [id])
  description             String?
  status                  JobAdStatus     @default(DRAFT)
  contractType            ContractType?   @map("contract_type")
  remote                  RemotePolicy?
  countryId               String?         @map("country_id") @db.Uuid
  country                 Country?        @relation(fields: [countryId], references: [id])
  cityId                  String?         @map("city_id") @db.Uuid
  city                    City?           @relation(fields: [cityId], references: [id])
  salaryRange             String?         @map("salary_range") //String pour pouvoir rajouter la devise + range
  requiredYearsExperience Int?            @map("required_years_experience")
  requiredEducationLevel  EducationLevel? @map("required_education_level") //? à relier avec degree éventuellement
  applicationUrl          String?         @map("application_url")
  applicationEmail        String?         @map("application_email")
  publishedAt             DateTime?       @map("published_at")
  expiresAt               DateTime?       @map("expires_at")
  tags                    String[] // à voir pour faire une liste de tags prédéfinis
  metadata                Json?
  deletedAt               DateTime?       @map("deleted_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  requiredSkills JobAdSkill[]

  @@index([organizationId])
  @@index([jobId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([contractType])
  @@index([remote])
  @@index([publishedAt])
  @@map("job_ads")
}

/// Compétence requise pour une offre d'emploi (avec niveau d'importance)
model JobAdSkill {
  id         String          @id @default(uuid()) @db.Uuid
  jobAdId    String          @map("job_ad_id") @db.Uuid
  jobAd      JobAd           @relation(fields: [jobAdId], references: [id], onDelete: Cascade)
  skillId    String          @map("skill_id") @db.Uuid
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance @default(REQUIRED)

  @@unique([jobAdId, skillId])
  @@index([skillId])
  @@map("job_ad_skills")
}

// layer 2 : Users

/// Utilisateur (authentification & identité)
model User {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String     @unique
  emailVerified          Boolean    @default(false) @map("email_verified")
  passwordHash           String     @map("password_hash")
  firstName              String?    @map("first_name")
  lastName               String?    @map("last_name")
  displayName            String?    @map("display_name")
  avatarUrl              String?    @map("avatar_url")
  /// When the account represents a organisation, this stores the name.
  organisationName       String?    @map("organisation_name")
  /// Indicates whether the user has opted in to receive marketing communications.
  marketingOptIn         Boolean    @default(false) @map("marketing_opt_in")
  /// One‑time code sent to the user for email verification. Null when verification completed.
  verificationCode       String?    @map("verification_code")
  /// Expiration timestamp for the verification code.
  verificationExpiresAt  DateTime?  @map("verification_expires_at")
  /// Last time a verification email was sent, used to throttle re‑sends.
  lastVerificationSentAt DateTime?  @map("last_verification_sent_at")
  /// One‑time token used for password reset flows. Null when unused or expired.
  resetToken             String?    @map("reset_token")
  /// Expiration timestamp for the password reset token.
  resetExpiresAt         DateTime?  @map("reset_expires_at")
  /// Last time a password reset email was sent, used to throttle re‑sends.
  lastResetSentAt        DateTime?  @map("last_reset_sent_at")
  role                   UserRole   @default(USER)
  status                 UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt            DateTime?  @map("last_login_at")
  failedLoginAttempts    Int        @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?  @map("locked_until")
  passwordChangedAt      DateTime?  @map("password_changed_at")
  metadata               Json?
  deletedAt              DateTime?  @map("deleted_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  sessions  UserSession[]
  profile   UserProfile?
  auditlogs AuditLog[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Profil public user
model UserProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @unique @map("user_id") @db.Uuid
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  biography             String?
  countryId             String?       @map("country_id") @db.Uuid
  country               Country?      @relation("UserProfileCountry", fields: [countryId], references: [id])
  cityId                String?       @map("city_id") @db.Uuid
  city                  City?         @relation(fields: [cityId], references: [id])
  linkedinUrl           String?       @map("linkedin_url")
  githubUrl             String?       @map("github_url")
  websiteUrl            String?       @map("website_url")
  locale                String?       @default("fr")
  timezone              String?
  isPublic              Boolean       @default(true) @map("is_public")
  currentJobId          String?       @map("current_job_id") @db.Uuid
  currentJob            Job?          @relation("UserCurrentJob", fields: [currentJobId], references: [id])
  currentJobStartedAt   DateTime?     @map("current_job_started_at")
  currentOrganizationId String?       @map("current_organization_id") @db.Uuid
  currentOrganization   Organization? @relation("UserCurrentOrganization", fields: [currentOrganizationId], references: [id])
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([cityId])
  @@index([currentJobId])
  @@index([currentOrganizationId])
  @@map("user_profiles")
}

/// Journal d'audit des actions sensibles (auth, changements de rôle, etc.)
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: SetDefault)
  action    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
