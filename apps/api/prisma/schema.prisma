generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

<<<<<<<<< Temporary merge branch 1
model Industry {
  id            String      @id @default(uuid()) @db.Uuid
  serial_number String?     @unique
  name          String
  description   String?
  medianSalary  String?     @map("median_salary")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  cities        City[]      @relation("CityToIndustry")
  companies     companies[] @relation("CompanyToIndustry")
  countries     Country[]   @relation("CountryToIndustry")
  products      Subject[]   @relation("IndustryToProduct")
  skills        Skill[]     @relation("IndustryToSkill")

  @@map("industries")
}

model Country {
  id                                       String       @id @default(uuid()) @db.Uuid
  serial_number                            String?      @unique
  country_name                             String
  qualityOfLife                            String?      @map("quality_of_life")
  temperatures                             String?
  climate                                  String?
  crimeRate                                String?      @map("crime_rate")
  incomeInequality                         String?      @map("income_inequality")
  workLifeBalance                          String?      @map("work_life_balance")
  population                               String?
  currency                                 String?
  largest_companies                        String[]
  numberOfMultinationalHqs                 Int?         @map("number_of_multinational_hqs")
  medianSalary                             String?      @map("median_salary")
  personalIncomeTax                        String?      @map("personal_income_tax")
  costOfLiving                             String?      @map("cost_of_living")
  medianHomePrice                          String?      @map("median_home_price")
  averageRent                              String?      @map("average_rent")
  interestingFact                          String?      @map("interesting_fact")
  citizenshipProcess                       String?      @map("citizenship_process")
  workPermit                               String?      @map("work_permit")
  globalCompetitivenessIndex               String?      @map("global_competitiveness_index")
  level_of_globalization                   String?
  numberOfInternationalStudents            String?      @map("number_of_international_students")
  numberOfForeignCompanies                 String?      @map("number_of_foreign_companies")
  numberOfTourists                         String?      @map("number_of_tourists")
  numberOfAirports                         Int?         @map("number_of_airports")
  qualityOfEducation                       String?      @map("quality_of_education")
  degreeHolders                            String?      @map("degree_holders")
  numberOfUniversities                     Int?         @map("number_of_universities")
  ethnicGroups                             String[]     @map("ethnic_groups")
  languages                                String[]
  religion                                 String[]
  culturalValues                           String?      @map("cultural_values")
  peopleDescription                        String?      @map("people_description")
  capital_city_id                          String?      @db.Uuid
  createdAt                                DateTime     @default(now()) @map("created_at")
  updatedAt                                DateTime     @updatedAt @map("updated_at")
  candidates                               candidates[]
  cities                                   City[]
  cities_countries_capital_city_idTocities City?        @relation("countries_capital_city_idTocities", fields: [capital_city_id], references: [id])
  jobOffers                                JobOffer[]
  industries                               Industry[]   @relation("CountryToIndustry")
  universities                             University[] @relation("CountryToUniversity")

  @@index([capital_city_id])
  @@map("countries")
}

model City {
  id                                          String                  @id @default(uuid()) @db.Uuid
  serial_number                               String?                 @unique
  city_name                                   String
  population                                  String?
  numberOfMultinationalHqs                    Int?                    @map("number_of_multinational_hqs")
  numberOfAirports                            Int?                    @map("number_of_airports")
  largest_companies                           String[]
  medianSalary                                String?                 @map("median_salary")
  costOfLiving                                String?                 @map("cost_of_living")
  medianHomePrice                             String?                 @map("median_home_price")
  averageRent                                 String?                 @map("average_rent")
  temperatures                                String?
  climate                                     String?
  interestingFact                             String?                 @map("interesting_fact")
  degreeHolders                               String?                 @map("degree_holders")
  numberOfUniversities                        Int?                    @map("number_of_universities")
  numberOfNationalities                       String?                 @map("number_of_nationalities")
  languages                                   String[]
  peopleDescription                           String?                 @map("people_description")
  countryId                                   String?                 @map("country_id") @db.Uuid
  createdAt                                   DateTime                @default(now()) @map("created_at")
  updatedAt                                   DateTime                @updatedAt @map("updated_at")
  candidate_experiences                       candidate_experiences[]
  candidates                                  candidates[]
  country                                     Country?                @relation(fields: [countryId], references: [id])
  countries_countries_capital_city_idTocities Country[]               @relation("countries_capital_city_idTocities")
  jobOffers                                   JobOffer[]
  team_offices                                team_offices[]
  industries                                  Industry[]              @relation("CityToIndustry")
  universities                                University[]            @relation("CityToUniversity")

  @@index([countryId])
  @@map("cities")
}

model Job {
  id                    String                  @id @default(uuid()) @db.Uuid
  serial_number         String?                 @unique
  name                  String
  description           String?
  toolsAndTech          String[]                @map("tools_and_tech")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  candidate_experiences candidate_experiences[]
  jobOffers             JobOffer[]
  certifications        Certification[]         @relation("CertificationToJob")
  products              Subject[]               @relation("JobToProduct")
  skills                Skill[]                 @relation("JobToSkill")

  @@map("jobs")
}

model Skill {
  id                  String             @id @default(uuid()) @db.Uuid
  serial_number       String?            @unique
  name                String
  type                SkillType?
  categories          String[]
  usedIn              String[]           @map("used_in")
  productCategories   String[]           @map("product_categories")
  commonFieldsOfStudy String[]           @map("common_fields_of_study")
  relatedAbilities    String[]           @map("related_abilities")
  timeToMaster        String?            @map("time_to_master")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  candidate_skills    candidate_skills[]
  jobOfferSkills      JobOfferSkill[]
  industries          Industry[]         @relation("IndustryToSkill")
  jobs                Job[]              @relation("JobToSkill")

  @@map("skills")
}

model Certification {
  id                       String                     @id @default(uuid()) @db.Uuid
  serial_number            String?                    @unique
  name                     String
  level                    CertificationLevel?
  description              String?
  issued_by                String?
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  candidate_certifications candidate_certifications[]
  jobs                     Job[]                      @relation("CertificationToJob")
  products                 Subject[]                  @relation("CertificationToProduct")

  @@map("certifications")
}

model University {
  id                   String                 @id @default(uuid()) @db.Uuid
  serial_number        String?                @unique
  name                 String
  established          Int?
  type                 String?
  location             String?
  total_students       Int?
  undergraduates       Int?
  postgraduates        Int?
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  candidate_educations candidate_educations[]
  cities               City[]                 @relation("CityToUniversity")
  countries            Country[]              @relation("CountryToUniversity")

  @@map("universities")
}

/// Produit / Service / Solution
model Subject {
  id                   String               @id @default(uuid()) @db.Uuid
  serial_number        String?              @unique
  name                 String
  type                 ProductType?
  product_type         String?
  description          String?
  funFact              String?              @map("fun_fact")
  companyId            String?              @map("company_id") @db.Uuid
  company_name         String?
  external_competitors String[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  candidate_products   candidate_products[]
  company              companies?           @relation(fields: [companyId], references: [id])
  team_products        team_products[]
  certifications       Certification[]      @relation("CertificationToProduct")
  industries           Industry[]           @relation("IndustryToProduct")
  job_offers           JobOffer[]           @relation("JobOfferToProduct")
  jobs                 Job[]                @relation("JobToProduct")
  products_A           Subject[]            @relation("ProductCompetitors")
  products_B           Subject[]            @relation("ProductCompetitors")

  @@index([companyId])
  @@map("products")
}

/// Fait d'information vérifiable
model Fact {
  id            String   @id @default(uuid()) @db.Uuid
  serial_number String?  @unique
  hashtag_1     String?
  icon_1        String?
  hashtag_2     String?
  title         String?
  story         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("facts")
}

model JobOffer {
  id                  String                @id @default(uuid()) @db.Uuid
  company_account_id  String                @db.Uuid
  title               String
  description         String?
  jobId               String?               @map("job_id") @db.Uuid
  cityId              String?               @map("city_id") @db.Uuid
  countryId           String?               @map("country_id") @db.Uuid
  salary_min          Int?
  salary_max          Int?
  salary_currency     String?
  employment_type     EmploymentType?
  seniority           Seniority?
  remote_type         RemoteType?
  status              JobOfferStatus        @default(DRAFT)
  publishedAt         DateTime?             @map("published_at")
  closed_at           DateTime?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  job_offer_languages job_offer_languages[]
  requiredSkills      JobOfferSkill[]
  city                City?                 @relation(fields: [cityId], references: [id])
  company_accounts    company_accounts      @relation(fields: [company_account_id], references: [id], onDelete: Cascade)
  country             Country?              @relation(fields: [countryId], references: [id])
  job                 Job?                  @relation(fields: [jobId], references: [id])
  proposals           proposals[]
  products            Subject[]             @relation("JobOfferToProduct")

  @@index([jobId])
  @@index([cityId])
  @@index([status])
  @@index([company_account_id])
  @@map("job_offers")
}

/// Compétence requise pour une offre d'emploi (avec niveau d'importance)
model JobOfferSkill {
  id         String          @id @default(uuid()) @db.Uuid
  jobOfferId String          @map("job_offer_id") @db.Uuid
  skillId    String          @map("skill_id") @db.Uuid
  importance SkillImportance @default(REQUIRED)
  jobOffer   JobOffer        @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id])

  @@unique([jobOfferId, skillId])
  @@index([skillId])
  @@map("job_offer_skills")
}

model candidate_certifications {
  id               String        @id @db.Uuid
  candidate_id     String        @db.Uuid
  certification_id String        @db.Uuid
  date_obtained    DateTime?     @db.Date
  expiry_date      DateTime?     @db.Date
  created_at       DateTime      @default(now())
  candidates       candidates    @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  certifications   Certification @relation(fields: [certification_id], references: [id])

  @@unique([candidate_id, certification_id])
  @@index([certification_id])
}

model candidate_educations {
  id             String      @id @db.Uuid
  candidate_id   String      @db.Uuid
  university_id  String?     @db.Uuid
  school_name    String?
  degree         String?
  field_of_study String?
  start_year     Int?
  end_year       Int?
  created_at     DateTime    @default(now())
  candidates     candidates  @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  universities   University? @relation(fields: [university_id], references: [id])

  @@index([candidate_id])
  @@index([university_id])
}

model candidate_experiences {
  id           String     @id @db.Uuid
  candidate_id String     @db.Uuid
  company_id   String?    @db.Uuid
  company_name String?
  job_id       String?    @db.Uuid
  title        String?
  description  String?
  impact       String?
  start_date   DateTime?  @db.Date
  end_date     DateTime?  @db.Date
  is_current   Boolean    @default(false)
  city_id      String?    @db.Uuid
  created_at   DateTime   @default(now())
  candidates   candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  cities       City?      @relation(fields: [city_id], references: [id])
  companies    companies? @relation(fields: [company_id], references: [id])
  jobs         Job?       @relation(fields: [job_id], references: [id])

  @@index([candidate_id])
  @@index([company_id])
  @@index([job_id])
}

model candidate_languages {
  id           String           @id @db.Uuid
  candidate_id String           @db.Uuid
  language     String
  proficiency  ProficiencyLevel
  created_at   DateTime         @default(now())
  candidates   candidates       @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([candidate_id, language])
}

model candidate_products {
  id           String     @id @db.Uuid
  candidate_id String     @db.Uuid
  product_id   String     @db.Uuid
  context      String?
  created_at   DateTime   @default(now())
  candidates   candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  products     Subject    @relation(fields: [product_id], references: [id])

  @@unique([candidate_id, product_id])
  @@index([product_id])
}

model candidate_skills {
  id                  String            @id @db.Uuid
  candidate_id        String            @db.Uuid
  skill_id            String            @db.Uuid
  proficiency         ProficiencyLevel?
  years_of_experience Int?
  created_at          DateTime          @default(now())
  candidates          candidates        @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  skills              Skill             @relation(fields: [skill_id], references: [id])

  @@unique([candidate_id, skill_id])
  @@index([skill_id])
}

model candidates {
  id                       String                     @id @db.Uuid
  profile_id               String                     @unique @db.Uuid
  headline                 String?
  bio                      String?
  availability             Availability?
  status                   CandidateStatus            @default(ACTIVE)
  current_city_id          String?                    @db.Uuid
  origin_country_id        String?                    @db.Uuid
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  candidate_certifications candidate_certifications[]
  candidate_educations     candidate_educations[]
  candidate_experiences    candidate_experiences[]
  candidate_languages      candidate_languages[]
  candidate_products       candidate_products[]
  candidate_skills         candidate_skills[]
  cities                   City?                      @relation(fields: [current_city_id], references: [id])
  countries                Country?                   @relation(fields: [origin_country_id], references: [id])
  profiles                 profiles                   @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  proposal_candidates      proposal_candidates[]

  @@index([current_city_id])
  @@index([origin_country_id])
  @@index([status])
}

model companies {
  id                    String                  @id @db.Uuid
  serial_number         String?                 @unique
  organization_name     String
  category              String?
  founded               Int?
  company_type          CompanyType?
  headquarters_location String?
  number_of_offices     Int?
  number_of_employees   String?
  subsidiaries_count    Int?
  known_for             String?
  parent_id             String?                 @db.Uuid
  created_at            DateTime                @default(now())
  updated_at            DateTime
  candidate_experiences candidate_experiences[]
  companies             companies?              @relation("companiesTocompanies", fields: [parent_id], references: [id])
  other_companies       companies[]             @relation("companiesTocompanies")
  company_accounts      company_accounts[]
  subjects              Subject[]
  industries            Industry[]              @relation("CompanyToIndustry")

  @@index([parent_id])
}

model company_accounts {
  id              String            @id @db.Uuid
  company_id      String?           @db.Uuid
  contact_email   String
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime
  companies       companies?        @relation(fields: [company_id], references: [id])
  company_members company_members[]
  job_offers      JobOffer[]
  proposals       proposals[]
  teams           teams[]

  @@index([company_id])
}

model company_members {
  id                 String            @id @db.Uuid
  profile_id         String            @unique @db.Uuid
  company_account_id String            @db.Uuid
  role               CompanyMemberRole @default(MEMBER)
  created_at         DateTime          @default(now())
  updated_at         DateTime
  company_accounts   company_accounts  @relation(fields: [company_account_id], references: [id], onDelete: Cascade)
  profiles           profiles          @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([company_account_id])
}

model job_offer_languages {
  id              String           @id @db.Uuid
  job_offer_id    String           @db.Uuid
  language        String
  min_proficiency ProficiencyLevel
  job_offers      JobOffer         @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)

  @@unique([job_offer_id, language])
}

model profiles {
  id               String           @id @db.Uuid
  email            String           @unique
  role             UserRole
  first_name       String?
  last_name        String?
  avatar_url       String?
  phone            String?
  marketing_opt_in Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime
  candidates       candidates?
  company_members  company_members?
}

model proposal_candidates {
  id           String           @id @db.Uuid
  proposal_id  String           @db.Uuid
  candidate_id String           @db.Uuid
  rank         Int
  admin_note   String?
  decision     ProposalDecision @default(PENDING)
  company_note String?
  decided_at   DateTime?
  created_at   DateTime         @default(now())
  candidates   candidates       @relation(fields: [candidate_id], references: [id])
  proposals    proposals        @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@unique([proposal_id, candidate_id])
  @@unique([proposal_id, rank])
  @@index([candidate_id])
}

model proposals {
  id                  String                @id @db.Uuid
  job_offer_id        String                @db.Uuid
  company_account_id  String                @db.Uuid
  status              ProposalStatus        @default(DRAFT)
  admin_note          String?
  sent_at             DateTime?
  viewed_at           DateTime?
  created_at          DateTime              @default(now())
  updated_at          DateTime
  proposal_candidates proposal_candidates[]
  company_accounts    company_accounts      @relation(fields: [company_account_id], references: [id])
  job_offers          JobOffer              @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)

  @@index([company_account_id])
  @@index([job_offer_id])
  @@index([status])
}

model team_members {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id    String   @db.Uuid
  name       String
  job_title  String?
  photo_url  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  teams      teams    @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([team_id])
}

model team_offices {
  id      String @id @db.Uuid
  team_id String @db.Uuid
  city_id String @db.Uuid
  cities  City   @relation(fields: [city_id], references: [id])
  teams   teams  @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, city_id])
  @@index([city_id])
}

model team_products {
  id         String  @id @db.Uuid
  team_id    String  @db.Uuid
  product_id String  @db.Uuid
  products   Subject @relation(fields: [product_id], references: [id])
  teams      teams   @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, product_id])
  @@index([product_id])
}

model teams {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_account_id   String           @db.Uuid
  name                 String
  who_we_are           String?
  what_we_are_great_at String?
  team_culture         String?
  how_we_work_together String?
  not_for_you_if       String?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @default(now())
  team_members         team_members[]
  team_offices         team_offices[]
  team_products        team_products[]
  company_accounts     company_accounts @relation(fields: [company_account_id], references: [id], onDelete: Cascade)

  @@index([company_account_id])
}

