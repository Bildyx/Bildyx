generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Industry {
  id                                                  String         @id @default(uuid()) @db.Uuid
  name                                                String
  serial_number                                       String         @unique
  description                                         String?
  iconUrl                                             String?        @map("icon_url")
  score                                               Int?
  jobs                                                Job[]
  organizations_organizations_industry_idToindustries Organization[] @relation("organizations_industry_idToindustries")
  mainIndustryCities                                  City[]         @relation("CityMainIndustries")
  organizations                                       Organization[] @relation("OrganizationIndustries")
  products                                            Subject[]      @relation("ProductIndustries")
  industries_A                                        Industry[]     @relation("RelatedIndustries")
  industries_B                                        Industry[]     @relation("RelatedIndustries")

  @@map("industries")
}

model Country {
  isoCode                       String          @id @map("iso_code") @db.Char(2)
  name                          String
  serial_number                 String          @unique
  capitalName                   String?         @map("capital_name")
  flagUrl                       String?         @map("flag_url")
  population                    String?
  areaKm2                       Int?            @map("area_km2")
  gdpUsd                        Float?          @map("gdp_usd")
  gdpPerCapitaUsd               Float?          @map("gdp_per_capita_usd")
  hdi                           Float?
  officialLanguages             Language[]
  callingCode                   String?         @map("calling_code")
  governmentType                GovernmentType? @map("government_type")
  qualityOfLife                 QualityOfLife?  @map("quality_of_life")
  temperatures                  String?
  climate                       String?
  crimeRate                     String?         @map("crime_rate")
  incomeInequality              String?         @map("income_inequality")
  workLifeBalance               String?         @map("work_life_balance")
  mainIndustries                String?         @map("main_industries")
  numberOfMultinationalHqs      String?         @map("number_of_multinational_hqs")
  currency                      Currency?
  medianSalary                  Int?            @map("median_salary")
  medianHomePrice               Int?            @map("median_home_price")
  averageRent                   Int?            @map("average_rent")
  costOfLiving                  CostOfLiving?   @map("cost_of_living")
  interestingFact               String?         @map("interesting_fact")
  citizenshipProcess            String?         @map("citizenship_process")
  workPermit                    String?         @map("work_permit")
  globalCompetitivenessIndex    String?         @map("global_competitiveness_index")
  levelOfGlobalisation          String?         @map("level_of_globalisation")
  numberOfInternationalStudents Int?            @map("number_of_international_students")
  numberOfForeignOrganizations  Int?            @map("number_of_foreign_organizations")
  personalIncomeTax             String?         @map("personal_income_tax")
  numberOfTourists              String?         @map("number_of_tourists")
  numberOfAirports              String?         @map("number_of_airports")
  qualityOfEducation            String?         @map("quality_of_education")
  degreeHolders                 String?         @map("degree_holders")
  numberOfUniversities          Int?            @map("number_of_universities")
  top_universities              String?
  ethnicGroups                  String?         @map("ethnic_groups")
  religion                      String?
  culturalValues                String?         @map("cultural_values")
  peopleDescription             String?         @map("people_description")
  cities                        City[]
  jobAds                        JobAd[]
  userProfiles                  UserProfile[]   @relation("UserProfileCountry")
  organizations                 Organization[]  @relation("OrganizationCountries")

  @@map("countries")
}

model City {
  id                         String                 @id @default(uuid()) @db.Uuid
  name                       String
  serial_number              String                 @unique
  countryId                  String                 @map("country_id") @db.Char(2)
  isCapital                  Boolean                @default(false) @map("is_capital")
  stateProvince              String?                @map("state_province")
  population                 String?
  numberOfMultinationalHqs   String?                @map("number_of_multinational_hqs")
  numberOfAirports           Int?                   @map("number_of_airports")
  largest_organization       String?
  currency                   Currency
  medianSalary               Int?                   @map("median_salary")
  medianHomePrice            Int?                   @map("median_home_price")
  averageRent                Int?                   @map("average_rent")
  costOfLiving               CostOfLiving?          @map("cost_of_living")
  temperatures               String?
  climate                    String?
  interestingFact            String?                @map("interesting_fact")
  degreeHolders              String?                @map("degree_holders")
  numberOfUniversities       Int?                   @map("number_of_universities")
  top_universities           String?
  numberOfNationalities      String?                @map("number_of_nationalities")
  language                   Language[]
  peopleDescription          String?                @map("people_description")
  latitude                   Float?
  longitude                  Float?
  country                    Country                @relation(fields: [countryId], references: [isoCode])
  jobAds                     JobAd[]
  organization_offices       organization_offices[]
  headquarteredOrganizations Organization[]         @relation("OrganizationHeadquarters")
  teams                      teams[]
  userProfiles               UserProfile[]
  mainIndustries             Industry[]             @relation("CityMainIndustries")
  organizations_working_area Organization[]         @relation("working_area")

  @@index([countryId])
  @@map("cities")
}

model Organization {
  id                                                                                 String                      @id @default(uuid()) @db.Uuid
  name                                                                               String
  slug                                                                               String                      @unique
  ownership                                                                          String?
  mission                                                                            String?
  knownFor                                                                           String?                     @map("known_for")
  researchAreas                                                                      String[]                    @map("research_areas")
  products                                                                           String[]
  services                                                                           String[]
  budget                                                                             String?
  founded                                                                            String?
  score                                                                              Int?
  city_id                                                                            String?                     @db.Uuid
  numberOfEmployees                                                                  EmployeeCountRange?
  parentOrganizationId                                                               String?                     @map("parent_organization_id") @db.Uuid
  authority                                                                          String?
  collections                                                                        String?
  description                                                                        String?
  facilities                                                                         String[]
  founders                                                                           String[]
  jurisdiction                                                                       String?
  members                                                                            Int?
  personnel                                                                          Int?
  programsActivities                                                                 String[]                    @map("programs_activities")
  serial_number                                                                      String                      @unique
  subtype                                                                            OrganizationSubType?
  type1                                                                              String?
  type2                                                                              String?
  undergraduates                                                                     Int?
  studentCount                                                                       Int?                        @map("student_count")
  postgraduates                                                                      Int?
  profile_url                                                                        String?
  avatar_url                                                                         String?
  is_public                                                                          Boolean?
  website_url                                                                        String?
  industry_id                                                                        String?                     @db.Uuid
  issuedCertifications                                                               Certification[]             @relation("CertificationIssuer")
  jobAds                                                                             JobAd[]
  organization_customers_organization_customers_customer_idToorganizations           organization_customers[]    @relation("organization_customers_customer_idToorganizations")
  organization_customers_organization_customers_organization_idToorganizations       organization_customers[]    @relation("organization_customers_organization_idToorganizations")
  organization_investors_organization_investors_investor_idToorganizations           organization_investors[]    @relation("organization_investors_investor_idToorganizations")
  organization_investors_organization_investors_organization_idToorganizations       organization_investors[]    @relation("organization_investors_organization_idToorganizations")
  organization_offices                                                               organization_offices[]
  organization_partners_organization_partners_organization_idToorganizations         organization_partners[]     @relation("organization_partners_organization_idToorganizations")
  organization_partners_organization_partners_partner_idToorganizations              organization_partners[]     @relation("organization_partners_partner_idToorganizations")
  organization_photos                                                                organization_photos[]
  organization_subsidiaries_organization_subsidiaries_organization_idToorganizations organization_subsidiaries[] @relation("organization_subsidiaries_organization_idToorganizations")
  organization_subsidiaries_organization_subsidiaries_subsidiary_idToorganizations   organization_subsidiaries[] @relation("organization_subsidiaries_subsidiary_idToorganizations")
  headquartersCity                                                                   City?                       @relation("OrganizationHeadquarters", fields: [city_id], references: [id])
  industries_organizations_industry_idToindustries                                   Industry?                   @relation("organizations_industry_idToindustries", fields: [industry_id], references: [id], onDelete: Cascade)
  parentOrganization                                                                 Organization?               @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childAgencies                                                                      Organization[]              @relation("OrganizationHierarchy")
  subjects                                                                           Subject[]
  teams                                                                              teams[]
  userEducations                                                                     UserEducations[]
  userExperiences                                                                    UserExperience[]
  userTargetLists                                                                    UserTargetList[]
  user                                                                               User?
  countries                                                                          Country[]                   @relation("OrganizationCountries")
  industries                                                                         Industry[]                  @relation("OrganizationIndustries")
  cities_working_area                                                                City[]                      @relation("working_area")

  @@index([parentOrganizationId])
  @@index([subtype])
  @@index([city_id])
  @@map("organizations")
}

model Job {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  serial_number   String           @unique
  category        JobCategory?
  description     String?
  seniorityLevel  SeniorityLevel?  @map("seniority_level")
  industryId      String?          @map("industry_id") @db.Uuid
  products        String[]
  toolsAndTech    String[]         @map("tools_and_tech")
  tags            String[]
  score           Int?
  jobAds          JobAd[]
  industry        Industry?        @relation(fields: [industryId], references: [id])
  team_members    team_members[]
  userExperiences UserExperience[]

  @@index([industryId])
  @@index([category])
  @@index([seniorityLevel])
  @@map("jobs")
}

model Skill {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  serial_number       String           @unique
  type                String?
  category            String?
  description         String?
  iconUrl             String?          @map("icon_url")
  industry            String?
  difficulty          DifficultyLevel?
  usedIn              String[]         @map("used_in")
  jobs                String[]
  productCategories   String[]         @map("product_categories")
  commonFieldsOfStudy String[]         @map("common_fields_of_study")
  relatedAbilities    String[]         @map("related_abilities")
  timeToMaster        String?          @map("time_to_master")
  score               Int?
  jobAdSkills         JobAdSkill[]
  userSkills          UserSkill[]

  @@index([category])
  @@map("skills")
}

model Certification {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  serial_number          String                 @unique
  issuingOrganizationId  String?                @map("issuing_organization_id") @db.Uuid
  description            String?
  level                  String?
  category               CertificationCategory?
  products               String[]
  jobs                   String[]
  validityDurationMonths Int?                   @map("validity_duration_months")
  difficulty             DifficultyLevel?
  websiteUrl             String?                @map("website_url")
  score                  Int?
  issuingOrganization    Organization?          @relation("CertificationIssuer", fields: [issuingOrganizationId], references: [id])
  user_certifications    UserCertifications[]

  @@index([issuingOrganizationId])
  @@index([category])
  @@map("certifications")
}

model Degree {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  serial_number   String           @unique
  level           DegreeLevel?
  area            String?
  durationYears   Float?           @map("duration_years")
  description     String?
  score           Int?
  user_educations UserEducations[]

  @@index([level])
  @@map("degrees")
}

model Subject {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  serial_number       String             @unique
  type                String?
  description         String?
  short_description   String?
  competitors         String[]
  vendors             String[]
  fun_fact            String?
  organization_id     String             @db.Uuid
  website_url         String?
  logo_url            String?
  tags                String[]
  score               Int?
  subject_category_id String             @db.Uuid
  organization        Organization       @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  subject_categories  subject_categories @relation(fields: [subject_category_id], references: [id], onDelete: NoAction)
  team_subjects       team_subjects[]
  user_experiences    UserExperience[]
  industries          Industry[]         @relation("ProductIndustries")

  @@index([organization_id])
  @@map("subjects")
}

model StudyFields {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  serial_number         String                @unique
  area                  String?
  description           String?
  score                 Int?
  metadata              Json?
  deleted_at            DateTime?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  user_education_fields UserEducationFields[]
}

model JobAd {
  id                      String          @id @default(uuid()) @db.Uuid
  title                   String
  serial_number           String          @unique
  organizationId          String          @map("organization_id") @db.Uuid
  jobId                   String?         @map("job_id") @db.Uuid
  description             String?
  status                  JobAdStatus     @default(DRAFT)
  contractType            ContractType?   @map("contract_type")
  remote                  RemotePolicy?
  countryId               String?         @map("country_id") @db.Char(2)
  cityId                  String?         @map("city_id") @db.Uuid
  salaryRange             String?         @map("salary_range")
  requiredYearsExperience Int?            @map("required_years_experience")
  requiredEducationLevel  EducationLevel? @map("required_education_level")
  applicationUrl          String?         @map("application_url")
  applicationEmail        String?         @map("application_email")
  publishedAt             DateTime?       @map("published_at")
  expiresAt               DateTime?       @map("expires_at")
  tags                    String[]
  requiredSkills          JobAdSkill[]
  city                    City?           @relation(fields: [cityId], references: [id])
  country                 Country?        @relation(fields: [countryId], references: [isoCode])
  job                     Job?            @relation(fields: [jobId], references: [id])
  organization            Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([jobId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([contractType])
  @@index([remote])
  @@index([publishedAt])
  @@map("job_ads")
}

/// Skill required for a job ad (with importance level)
model JobAdSkill {
  id         String          @id @default(uuid()) @db.Uuid
  jobAdId    String          @map("job_ad_id") @db.Uuid
  skillId    String          @map("skill_id") @db.Uuid
  importance SkillImportance @default(REQUIRED)
  jobAd      JobAd           @relation(fields: [jobAdId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id])

  @@unique([jobAdId, skillId])
  @@index([skillId])
  @@map("job_ad_skills")
}

/// User (authentication & identity)
model User {
  id                     String        @id @default(uuid()) @db.Uuid
  email                  String        @unique
  emailVerified          Boolean       @default(false) @map("email_verified")
  passwordHash           String        @map("password_hash")
  organization_id        String?       @unique @db.Uuid
  /// Indicates whether the user has opted in to receive marketing communications.
  marketingOptIn         Boolean       @default(false) @map("marketing_opt_in")
  /// One‑time code sent to the user for email verification. Null when verification completed.
  verificationCode       String?       @map("verification_code")
  /// Expiration timestamp for the verification code.
  verificationExpiresAt  DateTime?     @map("verification_expires_at")
  /// Last time a verification email was sent, used to throttle re‑sends.
  lastVerificationSentAt DateTime?     @map("last_verification_sent_at")
  /// One‑time token used for password reset flows. Null when unused or expired.
  resetToken             String?       @map("reset_token")
  /// Expiration timestamp for the password reset token.
  resetExpiresAt         DateTime?     @map("reset_expires_at")
  /// Last time a password reset email was sent, used to throttle re‑sends.
  lastResetSentAt        DateTime?     @map("last_reset_sent_at")
  role                   UserRole      @default(CANDIDATE)
  status                 UserStatus    @default(PENDING_VERIFICATION)
  lastLoginAt            DateTime?     @map("last_login_at")
  failedLoginAttempts    Int           @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?     @map("locked_until")
  passwordChangedAt      DateTime?     @map("password_changed_at")
  audit_logs             AuditLog[]
  profile                UserProfile?
  sessions               UserSession[]
  organization           Organization? @relation(fields: [organization_id], references: [id])

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Public user profile
model UserProfile {
  id                       String                  @id @default(uuid()) @db.Uuid
  userId                   String                  @unique @map("user_id") @db.Uuid
  biography                String?
  countryId                String?                 @map("country_id") @db.Char(2)
  cityId                   String?                 @map("city_id") @db.Uuid
  linkedinUrl              String?                 @map("linkedin_url")
  githubUrl                String?                 @map("github_url")
  websiteUrl               String?                 @map("website_url")
  isPublic                 Boolean                 @default(true) @map("is_public")
  first_name               String?
  last_name                String?
  display_name             String?
  avatar_url               String?
  role                     String?
  personality_test_results PersonalityTestResult[]
  user_certifications      UserCertifications[]
  user_educations          UserEducations[]
  user_experiences         UserExperience[]
  user_languages           UserLanguage[]
  city                     City?                   @relation(fields: [cityId], references: [id])
  country                  Country?                @relation("UserProfileCountry", fields: [countryId], references: [isoCode])
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  user_skills              UserSkill[]
  user_target_lists        UserTargetList[]

  @@index([countryId])
  @@index([cityId])
  @@map("user_profiles")
}

model UserCertifications {
  id               String        @id @default(uuid()) @db.Uuid
  user_profile_id  String        @db.Uuid
  certification_id String        @db.Uuid
  obtained_at      DateTime?
  expires_at       DateTime?
  certification    Certification @relation(fields: [certification_id], references: [id])
  user_profile     UserProfile   @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, certification_id])
  @@index([certification_id])
  @@map("user_certifications")
}

model UserEducations {
  id                    String                @id @default(uuid()) @db.Uuid
  user_profile_id       String                @db.Uuid
  degree_id             String?               @db.Uuid
  start_year            Int?
  end_year              Int?
  graduated             Boolean               @default(false)
  organization_id       String?               @db.Uuid
  user_education_fields UserEducationFields[]
  degree                Degree?               @relation(fields: [degree_id], references: [id])
  organization          Organization?         @relation(fields: [organization_id], references: [id])
  user_profile          UserProfile           @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_profile_id])
  @@map("user_educations")
}

model UserEducationFields {
  id                String             @id @default(uuid()) @db.Uuid
  user_education_id String             @db.Uuid
  study_field_Id    String             @db.Uuid
  type              EducationFieldType
  studyField        StudyFields        @relation(fields: [study_field_Id], references: [id])
  user_education    UserEducations     @relation(fields: [user_education_id], references: [id], onDelete: Cascade)

  @@unique([user_education_id, study_field_Id])
  @@index([study_field_Id])
  @@index([type])
  @@map("user_education_fields")
}

/// A work experience in a profile's career history (position held,
/// optionally linked to a reference Organization/Job).
model UserExperience {
  id              String        @id @default(uuid()) @db.Uuid
  user_profile_id String        @db.Uuid
  organization_id String?       @db.Uuid
  job_id          String?       @db.Uuid
  title           String?
  description     String?
  start_year      Int?
  end_year        Int?
  current         Boolean       @default(false)
  subject_id      String?       @db.Uuid
  job             Job?          @relation(fields: [job_id], references: [id])
  organization    Organization? @relation(fields: [organization_id], references: [id])
  subjects        Subject?      @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_profile    UserProfile   @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@index([user_profile_id])
  @@index([organization_id])
  @@index([job_id])
  @@map("user_experiences")
}

/// A language spoken by a profile, with its proficiency level.
model UserLanguage {
  id              String               @id @default(uuid()) @db.Uuid
  user_profile_id String               @db.Uuid
  language        Language
  proficiency     LanguageProficiency?
  user_profile    UserProfile          @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, language])
  @@map("user_languages")
}

/// A skill (reference Skill) mastered by a profile, with its
/// level.
model UserSkill {
  id              String           @id @default(uuid()) @db.Uuid
  user_profile_id String           @db.Uuid
  skill_id        String           @db.Uuid
  level           DifficultyLevel?
  skill           Skill            @relation(fields: [skill_id], references: [id])
  user_profile    UserProfile      @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, skill_id])
  @@index([skill_id])
  @@map("user_skills")
}

/// A company targeted by a profile (personal list of organizations the
/// candidate plans or wants to apply to).
model UserTargetList {
  id              String       @id @default(uuid()) @db.Uuid
  user_profile_id String       @db.Uuid
  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_profile    UserProfile  @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, organization_id])
  @@index([organization_id])
  @@map("user_target_lists")
}

/// Reference definition of a personality questionnaire (e.g. Big 5, DISC...).
/// Configuration data, independent of users.
model PersonalityTest {
  id          String                  @id @default(uuid()) @db.Uuid
  code        String                  @unique
  name        String
  description String?
  is_active   Boolean                 @default(true)
  criteria    PersonalityCriterion[]
  questions   PersonalityQuestion[]
  results     PersonalityTestResult[]

  @@map("personality_tests")
}

/// One of the scored criteria (0-100) of a PersonalityTest. Specific to each
/// test (two tests do not share their criteria).
model PersonalityCriterion {
  id          String                      @id @default(uuid()) @db.Uuid
  test_id     String                      @db.Uuid
  code        String
  name        String
  description String?
  order       Int
  test        PersonalityTest             @relation(fields: [test_id], references: [id], onDelete: Cascade)
  scores      PersonalityCriterionScore[]
  questions   PersonalityQuestion[]

  @@unique([test_id, code])
  @@unique([test_id, id])
  @@index([test_id])
  @@map("personality_criteria")
}

/// A question of a questionnaire, attached to the criterion it measures.
/// Expected answer: a score from 1 to 5 (Likert scale). `reverse_scored`
/// flags a reverse-worded question, whose score must be inverted
/// (6 - score) before being aggregated into the criterion score.
model PersonalityQuestion {
  id             String               @id @default(uuid()) @db.Uuid
  test_id        String               @db.Uuid
  criterion_id   String               @db.Uuid
  order          Int
  text           String
  reverse_scored Boolean              @default(false)
  answers        PersonalityAnswer[]
  criterion      PersonalityCriterion @relation(fields: [test_id, criterion_id], references: [test_id, id])
  test           PersonalityTest      @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@unique([test_id, order])
  @@index([criterion_id])
  @@map("personality_questions")
}

/// A user's result for a given test. Only one result per
/// (user_profile, test) - a new attempt overwrites the previous one
/// (application-level upsert, see upcoming routes).
model PersonalityTestResult {
  id               String                      @id @default(uuid()) @db.Uuid
  user_profile_id  String                      @db.Uuid
  test_id          String                      @db.Uuid
  completedAt      DateTime                    @map("completed_at")
  answers          PersonalityAnswer[]
  criterion_scores PersonalityCriterionScore[]
  test             PersonalityTest             @relation(fields: [test_id], references: [id])
  user_profile     UserProfile                 @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, test_id])
  @@index([test_id])
  @@map("personality_test_results")
}

/// A user's raw answer (1-5) to a question, for a given result - the
/// per-question score breakdown.
model PersonalityAnswer {
  id          String                @id @default(uuid()) @db.Uuid
  result_id   String                @db.Uuid
  question_id String                @db.Uuid
  raw_score   Int
  question    PersonalityQuestion   @relation(fields: [question_id], references: [id])
  result      PersonalityTestResult @relation(fields: [result_id], references: [id], onDelete: Cascade)

  @@unique([result_id, question_id])
  @@index([question_id])
  @@map("personality_answers")
}

/// Aggregated score (0-100) of a criterion for a given result - the
/// "overall score" per criterion.
model PersonalityCriterionScore {
  id           String                @id @default(uuid()) @db.Uuid
  result_id    String                @db.Uuid
  criterion_id String                @db.Uuid
  score        Int
  criterion    PersonalityCriterion  @relation(fields: [criterion_id], references: [id])
  result       PersonalityTestResult @relation(fields: [result_id], references: [id], onDelete: Cascade)

  @@unique([result_id, criterion_id])
  @@index([criterion_id])
  @@map("personality_criterion_scores")
}

/// Audit log of sensitive actions (auth, role changes, etc.)
model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  action    String
  ipAddress String? @map("ip_address")
  user      User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

/// Per-row content hash tracking for the incremental Excel/CSV -> DB import
/// (see apps/api/prisma/import/). A single table for the 11 reference
/// models, rather than a hash column on each of them.
model ImportRowHash {
  id             String   @id @default(uuid()) @db.Uuid
  modelName      String   @map("model_name")
  naturalKey     String   @map("natural_key")
  rowHash        String   @map("row_hash")
  lastImportedAt DateTime @map("last_imported_at")
  sourceFile     String?  @map("source_file")

  @@unique([modelName, naturalKey])
  @@map("import_row_hashes")
}

