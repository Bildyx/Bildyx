generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model audit_logs {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  action     String
  ip_address String?
  metadata   Json?
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: SetDefault)

  @@index([action])
  @@index([created_at])
  @@index([user_id])
}

model certifications {
  id                       String                 @id @db.Uuid
  name                     String
  serialNumber             String?                @unique
  issuing_organization_id  String?                @db.Uuid
  description              String?
  level                    String?
  category                 CertificationCategory?
  products                 String[]
  jobs                     String[]
  validity_duration_months Int?
  difficulty               DifficultyLevel?
  website_url              String?
  metadata                 Json?
  deleted_at               DateTime?
  created_at               DateTime               @default(now())
  updated_at               DateTime
  organizations            organizations?         @relation(fields: [issuing_organization_id], references: [id])

  @@index([category])
  @@index([issuing_organization_id])
}

model cities {
  id                                         String          @id @db.Uuid
  name                                       String
  serialNumber                               String          @unique
  country_id                                 String          @db.Uuid
  is_capital                                 Boolean         @default(false)
  state_province                             String?
  population                                 Int?
  number_of_multinational_hqs                Int?
  number_of_airports                         Int?
  median_salary                              Int?
  cost_of_living                             CostOfLiving?
  median_home_price                          Int?
  average_rent                               Int?
  temperatures                               String?
  climate                                    String?
  interesting_fact                           String?
  degree_holders                             String?
  number_of_universities                     Int?
  number_of_nationalities                    Int?
  language                                   Language?
  people_description                         String?
  latitude                                   Float?
  longitude                                  Float?
  metadata                                   Json?
  deleted_at                                 DateTime?
  created_at                                 DateTime        @default(now())
  updated_at                                 DateTime
  countries                                  countries       @relation(fields: [country_id], references: [id])
  job_ads                                    job_ads[]
  organizations_organizations_cityIdTocities organizations[] @relation("organizations_cityIdTocities")
  universities_universities_city_idTocities  universities[]  @relation("universities_city_idTocities")
  user_profiles                              user_profiles[]
  organizations_CityLargestOrganizations     organizations[] @relation("CityLargestOrganizations")
  industries                                 industries[]    @relation("CityMainIndustries")
  universities_CityTopUniversities           universities[]  @relation("CityTopUniversities")
  organizations_working_area                 organizations[] @relation("working_area")

  @@index([country_id])
}

model countries {
  id                                              String          @id @db.Uuid
  name                                            String
  serialNumber                                    String          @unique
  iso_code                                        String?         @unique @db.Char(2)
  capital_name                                    String?
  flag_url                                        String?
  population                                      BigInt?
  area_km2                                        Float?
  gdp_usd                                         Float?
  gdp_per_capita_usd                              Float?
  hdi                                             Float?
  currency                                        String?
  officialLanguages                               Language[]
  calling_code                                    String?
  government_type                                 GovernmentType?
  quality_of_life                                 QualityOfLife?
  temperatures                                    String?
  climate                                         String?
  crime_rate                                      String?
  income_inequality                               String?
  work_life_balance                               String?
  number_of_multinational_hqs                     Int?
  median_salary                                   Int?
  cost_of_living                                  CostOfLiving?
  median_home_price                               Int?
  average_rent                                    Int?
  interesting_fact                                String?
  citizenship_process                             String?
  work_permit                                     String?
  global_competitiveness_index                    Int?
  level_of_globalisation                          String?
  number_of_international_students                Int?
  number_of_foreign_organizations                 Int?
  personal_income_tax                             String?
  number_of_tourists                              Int?
  number_of_airports                              Int?
  quality_of_education                            String?
  degree_holders                                  String?
  number_of_universities                          Int?
  ethnic_groups                                   String[]
  religion                                        String[]
  cultural_values                                 String?
  people_description                              String?
  metadata                                        Json?
  deleted_at                                      DateTime?
  created_at                                      DateTime        @default(now())
  updated_at                                      DateTime
  cities                                          cities[]
  degrees                                         degrees[]
  job_ads                                         job_ads[]
  jobs                                            jobs[]
  universities_universities_country_idTocountries universities[]  @relation("universities_country_idTocountries")
  user_profiles                                   user_profiles[]
  organizations                                   organizations[] @relation("CountryLargestOrganizations")
  industries                                      industries[]    @relation("CountryMainIndustries")
  universities_CountryTopUniversities             universities[]  @relation("CountryTopUniversities")
}

model degrees {
  id                      String        @id @db.Uuid
  name                    String
  serialNumber            String        @unique
  university_id           String?       @db.Uuid
  level                   DegreeLevel?
  field                   String?
  duration_years          Float?
  description             String?
  language_of_instruction String?
  country_id              String?       @db.Uuid
  metadata                Json?
  deleted_at              DateTime?
  created_at              DateTime      @default(now())
  updated_at              DateTime
  countries               countries?    @relation(fields: [country_id], references: [id])
  universities            universities? @relation(fields: [university_id], references: [id])

  @@index([country_id])
  @@index([level])
  @@index([university_id])
}

model industries {
  id            String          @id @db.Uuid
  name          String
  serialNumber  String          @unique
  description   String?
  icon_url      String?
  color         String?
  metadata      Json?
  deleted_at    DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime
  jobs          jobs[]
  skills        skills[]
  cities        cities[]        @relation("CityMainIndustries")
  countries     countries[]     @relation("CountryMainIndustries")
  organizations organizations[] @relation("OrganizationIndustries")
  products      products[]      @relation("ProductIndustries")
  industries_A  industries[]    @relation("RelatedIndustries")
  industries_B  industries[]    @relation("RelatedIndustries")
}

model job_ad_skills {
  id         String          @id @db.Uuid
  job_ad_id  String          @db.Uuid
  skill_id   String          @db.Uuid
  importance SkillImportance @default(REQUIRED)
  job_ads    job_ads         @relation(fields: [job_ad_id], references: [id], onDelete: Cascade)
  skills     skills          @relation(fields: [skill_id], references: [id])

  @@unique([job_ad_id, skill_id])
  @@index([skill_id])
}

model job_ads {
  id                        String          @id @db.Uuid
  title                     String
  serialNumber              String          @unique
  organization_id           String          @db.Uuid
  job_id                    String?         @db.Uuid
  description               String?
  status                    JobAdStatus     @default(DRAFT)
  contract_type             ContractType?
  remote                    RemotePolicy?
  country_id                String?         @db.Uuid
  city_id                   String?         @db.Uuid
  salary_range              String?
  required_years_experience Int?
  required_education_level  EducationLevel?
  application_url           String?
  application_email         String?
  published_at              DateTime?
  expires_at                DateTime?
  tags                      String[]
  metadata                  Json?
  deleted_at                DateTime?
  created_at                DateTime        @default(now())
  updated_at                DateTime
  job_ad_skills             job_ad_skills[]
  cities                    cities?         @relation(fields: [city_id], references: [id])
  countries                 countries?      @relation(fields: [country_id], references: [id])
  jobs                      jobs?           @relation(fields: [job_id], references: [id])
  organizations             organizations   @relation(fields: [organization_id], references: [id])

  @@index([city_id])
  @@index([contract_type])
  @@index([country_id])
  @@index([job_id])
  @@index([organization_id])
  @@index([published_at])
  @@index([remote])
  @@index([status])
}

model jobs {
  id              String          @id @db.Uuid
  title           String
  serialNumber    String          @unique
  category        JobCategory?
  description     String?
  seniority_level SeniorityLevel?
  is_elected      Boolean         @default(false)
  is_regulated    Boolean         @default(false)
  start_year      Int?
  industry_id     String?         @db.Uuid
  country_id      String?         @db.Uuid
  products        String[]
  tools_and_tech  String[]
  tags            String[]
  metadata        Json?
  deleted_at      DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime
  job_ads         job_ads[]
  countries       countries?      @relation(fields: [country_id], references: [id])
  industries      industries?     @relation(fields: [industry_id], references: [id])
  user_profiles   user_profiles[]

  @@index([category])
  @@index([country_id])
  @@index([industry_id])
  @@index([seniority_level])
}

model organizations {
  id                                  String               @id @db.Uuid
  name                                String
  slug                                String               @unique
  type                                OrganizationSubType?
  legal_status                        String?
  category                            String?
  ownership                           String?
  mission                             String?
  known_for                           String[]
  activities                          String[]
  project                             String?
  research_areas                      String[]
  services                            String[]
  partnerships                        String[]
  budget                              String?
  founded                             String?
  founder                             String?
  equipments                          String?
  numberOfEmployees                   EmployeeCountRange?
  numberOfSubsidiaries                Int?
  parent_organization_id              String?              @db.Uuid
  metadata                            Json?
  deleted_at                          DateTime?
  created_at                          DateTime             @default(now())
  updated_at                          DateTime
  cityId                              String?              @db.Uuid
  certifications                      certifications[]
  job_ads                             job_ads[]
  cities_organizations_cityIdTocities cities?              @relation("organizations_cityIdTocities", fields: [cityId], references: [id])
  organizations                       organizations?       @relation("organizationsToorganizations", fields: [parent_organization_id], references: [id])
  other_organizations                 organizations[]      @relation("organizationsToorganizations")
  products                            products[]
  user_profiles                       user_profiles[]
  cities_CityLargestOrganizations     cities[]             @relation("CityLargestOrganizations")
  countries                           countries[]          @relation("CountryLargestOrganizations")
  industries                          industries[]         @relation("OrganizationIndustries")
  cities_working_area                 cities[]             @relation("working_area")

  @@index([parent_organization_id])
  @@index([type])
}

model products {
  id                String           @id @db.Uuid
  name              String
  serialNumber      String           @unique
  type              String?
  description       String?
  short_description String?
  category          SubjectCategory?
  competitors       String[]
  fun_fact          String?
  organization_id   String?          @db.Uuid
  website_url       String?
  logo_url          String?
  tags              String[]
  metadata          Json?
  deleted_at        DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime
  organizations     organizations?   @relation(fields: [organization_id], references: [id])
  industries        industries[]     @relation("ProductIndustries")

  @@index([category])
  @@index([organization_id])
}

model skills {
  id                     String           @id @db.Uuid
  name                   String
  serialNumber           String           @unique
  type                   String?
  category               SkillCategory?
  categories             String[]
  description            String?
  icon_url               String?
  industry_id            String?          @db.Uuid
  difficulty             DifficultyLevel?
  used_in                String[]
  jobs                   String[]
  product_categories     String[]
  common_fields_of_study String[]
  related_abilities      String[]
  time_to_master         String?
  metadata               Json?
  deleted_at             DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime
  job_ad_skills          job_ad_skills[]
  industries             industries?      @relation(fields: [industry_id], references: [id])

  @@index([category])
  @@index([industry_id])
}

model universities {
  id                                           String          @id @db.Uuid
  name                                         String
  serialNumber                                 String          @unique
  type                                         UniversityType?
  description                                  String?
  website_url                                  String?
  logo_url                                     String?
  founded_year                                 Int?
  country_id                                   String?         @db.Uuid
  city_id                                      String?         @db.Uuid
  is_public                                    Boolean?
  student_count                                Int?
  metadata                                     Json?
  deleted_at                                   DateTime?
  created_at                                   DateTime        @default(now())
  updated_at                                   DateTime
  score                                        Float?
  local_name                                   String?
  location                                     String?
  notes                                        String?
  established                                  String?
  undergraduates                               Int?
  postgraduates                                Int?
  degrees                                      degrees[]
  cities_universities_city_idTocities          cities?         @relation("universities_city_idTocities", fields: [city_id], references: [id])
  countries_universities_country_idTocountries countries?      @relation("universities_country_idTocountries", fields: [country_id], references: [id])
  cities_CityTopUniversities                   cities[]        @relation("CityTopUniversities")
  countries_CountryTopUniversities             countries[]     @relation("CountryTopUniversities")

  @@index([city_id])
  @@index([country_id])
  @@index([type])
}

model user_profiles {
  id                      String         @id @db.Uuid
  user_id                 String         @unique @db.Uuid
  biography               String?
  country_id              String?        @db.Uuid
  city_id                 String?        @db.Uuid
  linkedin_url            String?
  github_url              String?
  website_url             String?
  locale                  String?        @default("fr")
  timezone                String?
  is_public               Boolean        @default(true)
  current_job_id          String?        @db.Uuid
  current_job_started_at  DateTime?
  current_organization_id String?        @db.Uuid
  metadata                Json?
  created_at              DateTime       @default(now())
  updated_at              DateTime
  cities                  cities?        @relation(fields: [city_id], references: [id])
  countries               countries?     @relation(fields: [country_id], references: [id])
  jobs                    jobs?          @relation(fields: [current_job_id], references: [id])
  organizations           organizations? @relation(fields: [current_organization_id], references: [id])
  users                   users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([city_id])
  @@index([country_id])
  @@index([current_job_id])
  @@index([current_organization_id])
}

model user_sessions {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id])
}

model users {
  id                        String          @id @db.Uuid
  email                     String          @unique
  email_verified            Boolean         @default(false)
  password_hash             String
  first_name                String?
  last_name                 String?
  display_name              String?
  avatar_url                String?
  organisation_name         String?
  marketing_opt_in          Boolean         @default(false)
  verification_code         String?
  verification_expires_at   DateTime?
  last_verification_sent_at DateTime?
  reset_token               String?
  reset_expires_at          DateTime?
  last_reset_sent_at        DateTime?
  role                      UserRole        @default(USER)
  status                    UserStatus      @default(PENDING_VERIFICATION)
  last_login_at             DateTime?
  failed_login_attempts     Int             @default(0)
  locked_until              DateTime?
  password_changed_at       DateTime?
  metadata                  Json?
  deleted_at                DateTime?
  created_at                DateTime        @default(now())
  updated_at                DateTime
  audit_logs                audit_logs[]
  user_profiles             user_profiles?
  user_sessions             user_sessions[]

  @@index([role])
  @@index([status])
}

enum CertificationCategory {
  TECHNICAL
  PROFESSIONAL
  PROJECTMANAGEMENT
  VENDORPRODUCT
  LANGUAGE
  OTHER
}

enum ContractType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  OTHER
}

enum CostOfLiving {
  LOW
  MEDIAN
  HIGH
}

enum DegreeLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  PHD
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
