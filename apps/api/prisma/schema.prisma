  timeToMaster        String?          @map("time_to_master")
  metadata            Json?
  deleted_at          DateTime?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  job_ad_skills       job_ad_skills[]
  industries          Industry?        @relation(fields: [industry_id], references: [id])

  @@index([category])
  @@index([industry_id])
  @@map("skills")
}

model City {
