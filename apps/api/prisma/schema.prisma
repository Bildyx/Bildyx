model JobAd {
  id                      String          @id @default(uuid()) @db.Uuid
  title                   String
  serialNumber            String          @unique
  organizationId          String          @map("organization_id") @db.Uuid
  organization            Organization    @relation(fields: [organizationId], references: [id])
  jobId                   String?         @map("job_id") @db.Uuid
  job                     Job?            @relation(fields: [jobId], references: [id])
  description             String?
  status                  JobAdStatus     @default(DRAFT)
  contractType            ContractType?   @map("contract_type")
  remote                  RemotePolicy?
  countryId               String?         @map("country_id") @db.Uuid
  country                 Country?        @relation(fields: [countryId], references: [id])
  cityId                  String?         @map("city_id") @db.Uuid
  city                    City?           @relation(fields: [cityId], references: [id])
  salaryRange             String?         @map("salary_range") //String pour pouvoir rajouter la devise + range
  requiredYearsExperience Int?            @map("required_years_experience")
  requiredEducationLevel  EducationLevel? @map("required_education_level") //? à relier avec degree éventuellement
  applicationUrl          String?         @map("application_url")
  applicationEmail        String?         @map("application_email")
  publishedAt             DateTime?       @map("published_at")
  expiresAt               DateTime?       @map("expires_at")
  tags                    String[] // à voir pour faire une liste de tags prédéfinis
  metadata                Json?
  deletedAt               DateTime?       @map("deleted_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  requiredSkills JobAdSkill[]

  @@index([organizationId])
  @@index([jobId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([contractType])
  @@index([remote])
  @@index([publishedAt])
  @@map("job_ads")
}

/// Compétence requise pour une offre d'emploi (avec niveau d'importance)
model JobAdSkill {
  id         String          @id @default(uuid()) @db.Uuid
  jobAdId    String          @map("job_ad_id") @db.Uuid
  jobAd      JobAd           @relation(fields: [jobAdId], references: [id], onDelete: Cascade)
  skillId    String          @map("skill_id") @db.Uuid
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance @default(REQUIRED)

  @@unique([jobAdId, skillId])
  @@index([skillId])
  @@map("job_ad_skills")
}

// layer 2 : Users

/// Utilisateur (authentification & identité)
model User {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String     @unique
  emailVerified          Boolean    @default(false) @map("email_verified")
  passwordHash           String     @map("password_hash")
  firstName              String?    @map("first_name")
  lastName               String?    @map("last_name")
  displayName            String?    @map("display_name")
  avatarUrl              String?    @map("avatar_url")
  /// When the account represents a organisation, this stores the name.
  organisationName       String?    @map("organisation_name")
  /// Indicates whether the user has opted in to receive marketing communications.
  marketingOptIn         Boolean    @default(false) @map("marketing_opt_in")
  /// One‑time code sent to the user for email verification. Null when verification completed.
  verificationCode       String?    @map("verification_code")
  /// Expiration timestamp for the verification code.
  verificationExpiresAt  DateTime?  @map("verification_expires_at")
  /// Last time a verification email was sent, used to throttle re‑sends.
  lastVerificationSentAt DateTime?  @map("last_verification_sent_at")
  /// One‑time token used for password reset flows. Null when unused or expired.
  resetToken             String?    @map("reset_token")
  /// Expiration timestamp for the password reset token.
  resetExpiresAt         DateTime?  @map("reset_expires_at")
  /// Last time a password reset email was sent, used to throttle re‑sends.
  lastResetSentAt        DateTime?  @map("last_reset_sent_at")
  role                   UserRole   @default(USER)
  status                 UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt            DateTime?  @map("last_login_at")
  failedLoginAttempts    Int        @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?  @map("locked_until")
  passwordChangedAt      DateTime?  @map("password_changed_at")
  metadata               Json?
  deletedAt              DateTime?  @map("deleted_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  sessions  UserSession[]
  profile   UserProfile?
  auditlogs AuditLog[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Profil public user
model UserProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @unique @map("user_id") @db.Uuid
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  biography             String?
  countryId             String?       @map("country_id") @db.Uuid
  country               Country?      @relation("UserProfileCountry", fields: [countryId], references: [id])
  cityId                String?       @map("city_id") @db.Uuid
  city                  City?         @relation(fields: [cityId], references: [id])
  linkedinUrl           String?       @map("linkedin_url")
  githubUrl             String?       @map("github_url")
  websiteUrl            String?       @map("website_url")
  locale                String?       @default("fr")
  timezone              String?
  isPublic              Boolean       @default(true) @map("is_public")
  currentJobId          String?       @map("current_job_id") @db.Uuid
  currentJob            Job?          @relation("UserCurrentJob", fields: [currentJobId], references: [id])
  currentJobStartedAt   DateTime?     @map("current_job_started_at")
  currentOrganizationId String?       @map("current_organization_id") @db.Uuid
  currentOrganization   Organization? @relation("UserCurrentOrganization", fields: [currentOrganizationId], references: [id])
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([cityId])
  @@index([currentJobId])
  @@index([currentOrganizationId])
  @@map("user_profiles")
}

/// Journal d'audit des actions sensibles (auth, changements de rôle, etc.)
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: SetDefault)
  action    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
