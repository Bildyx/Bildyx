=========
model audit_logs {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  action     String
  ip_address String?
  metadata   Json?
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: SetDefault)

  @@index([action])
  @@index([created_at])
  @@index([user_id])
}

model City {
  id                       String   @id @default(uuid()) @db.Uuid
  serialNumber             String?  @unique @map("serial_number")
  name                     String   @map("city_name")
  population               String?
  numberOfMultinationalHQs Int?     @map("number_of_multinational_hqs")
  numberOfAirports         Int?     @map("number_of_airports")
  largestCompanies         String[] @map("largest_companies")
  medianSalary             String?  @map("median_salary")
  costOfLiving             String?  @map("cost_of_living")
  medianHomePrice          String?  @map("median_home_price")
  averageRent              String?  @map("average_rent")
  temperatures             String?
  climate                  String?
  interestingFact          String?  @map("interesting_fact")
  degreeHolders            String?  @map("degree_holders")
  numberOfUniversities     Int?     @map("number_of_universities")
  numberOfNationalities    String?  @map("number_of_nationalities")
  languages                String[]
  peopleDescription        String?  @map("people_description")

  countryId String?  @map("country_id") @db.Uuid
  country   Country? @relation("CountryCities", fields: [countryId], references: [id])

  capitalOf Country[] @relation("CountryCapital")

  mainIndustries  Industry[]
  topUniversities University[]

  candidatesInCity     Candidate[]           @relation("CandidateCurrentCity")
  candidateExperiences CandidateExperience[]
  teamOffices          TeamOffice[]
  jobOffers            JobOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId])
  @@map("cities")
}

model Country {
  id                            String   @id @default(uuid()) @db.Uuid
  serialNumber                  String?  @unique @map("serial_number")
  name                          String   @map("country_name")
  qualityOfLife                 String?  @map("quality_of_life")
  temperatures                  String?
  climate                       String?
  crimeRate                     String?  @map("crime_rate")
  incomeInequality              String?  @map("income_inequality")
  workLifeBalance               String?  @map("work_life_balance")
  population                    String?
  currency                      String?
  largestCompanies              String[] @map("largest_companies")
  numberOfMultinationalHQs      Int?     @map("number_of_multinational_hqs")
  medianSalary                  String?  @map("median_salary")
  personalIncomeTax             String?  @map("personal_income_tax")
  costOfLiving                  String?  @map("cost_of_living")
  medianHomePrice               String?  @map("median_home_price")
  averageRent                   String?  @map("average_rent")
  interestingFact               String?  @map("interesting_fact")
  citizenshipProcess            String?  @map("citizenship_process")
  workPermit                    String?  @map("work_permit")
  globalCompetitivenessIndex    String?  @map("global_competitiveness_index")
  levelOfGlobalization          String?  @map("level_of_globalization")
  numberOfInternationalStudents String?  @map("number_of_international_students")
  numberOfForeignCompanies      String?  @map("number_of_foreign_companies")
  numberOfTourists              String?  @map("number_of_tourists")
  numberOfAirports              Int?     @map("number_of_airports")
  qualityOfEducation            String?  @map("quality_of_education")
  degreeHolders                 String?  @map("degree_holders")
  numberOfUniversities          Int?     @map("number_of_universities")
  ethnicGroups                  String[] @map("ethnic_groups")
  languages                     String[]
  religion                      String[]
  culturalValues                String?  @map("cultural_values")
  peopleDescription             String?  @map("people_description")

  cities City[] @relation("CountryCities")

  capitalCityId String? @map("capital_city_id") @db.Uuid
  capital       City?   @relation("CountryCapital", fields: [capitalCityId], references: [id])

  mainIndustries  Industry[]
  topUniversities University[]

  candidatesFromCountry Candidate[] @relation("CandidateOriginCountry")
  jobOffers             JobOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([capitalCityId])
  @@map("countries")
}

model University {
  id             String  @id @default(uuid()) @db.Uuid
  serialNumber   String? @unique @map("serial_number")
  name           String
  established    Int?
  type           String?
  location       String?
  totalStudents  Int?    @map("total_students")
  undergraduates Int?
  postgraduates  Int?
  notes          String?

  cities    City[]
  countries Country[]

  candidateEducations CandidateEducation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("universities")
}

model Fact {
  id           String  @id @default(uuid()) @db.Uuid
  serialNumber String? @unique @map("serial_number")
  hashtag1     String? @map("hashtag_1")
  icon1        String? @map("icon_1")
  hashtag2     String? @map("hashtag_2")
  title        String?
  story        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("facts")
