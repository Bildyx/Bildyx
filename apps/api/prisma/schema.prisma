model Industry {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  serialNumber  String          @unique
  description   String?
  icon_url      String?
  color         String?
  metadata      Json?
  deleted_at    DateTime?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  jobs          Job[]
  skills        Skill[]
  cities        City[]          @relation("CityMainIndustries")
  countries     Country[]       @relation("CountryMainIndustries")
  organizations organizations[] @relation("OrganizationIndustries")
  products      Product[]       @relation("ProductIndustries")
  industries_A  Industry[]      @relation("RelatedIndustries")
  industries_B  Industry[]      @relation("RelatedIndustries")

  @@map("industries")
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  serialNumber      String           @unique
  type              String?
  description       String?
  short_description String?
  category          SubjectCategory?
  competitors       String[]
  funFact           String?          @map("fun_fact")
  organization_id   String?          @db.Uuid
  website_url       String?
  logo_url          String?
  tags              String[]
  metadata          Json?
  deleted_at        DateTime?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  organizations     organizations?   @relation(fields: [organization_id], references: [id])
  industries        Industry[]       @relation("ProductIndustries")

  @@index([category])
  @@index([organization_id])
  @@map("products")
}

model Certification {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String
  serialNumber             String                 @unique
  issuing_organization_id  String?                @db.Uuid
  description              String?
  level                    String?
  category                 CertificationCategory?
  products                 String[]
  jobs                     String[]
  validity_duration_months Int?
  difficulty               DifficultyLevel?
  website_url              String?
  metadata                 Json?
  deleted_at               DateTime?
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  organizations            organizations?         @relation(fields: [issuing_organization_id], references: [id])

  @@index([category])
  @@index([issuing_organization_id])
  @@map("certifications")
}

model Job {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  serialNumber    String          @unique
  category        JobCategory?
  description     String?
  seniority_level SeniorityLevel?
  is_elected      Boolean         @default(false)
  is_regulated    Boolean         @default(false)
  start_year      Int?
  industry_id     String?         @db.Uuid
  country_id      String?         @db.Uuid
  products        String[]
  toolsAndTech    String[]        @map("tools_and_tech")
  tags            String[]
  metadata        Json?
  deleted_at      DateTime?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  job_ads         job_ads[]
  countries       Country?        @relation(fields: [country_id], references: [id])
  industries      Industry?       @relation(fields: [industry_id], references: [id])
  user_profiles   user_profiles[]

  @@index([category])
  @@index([country_id])
  @@index([industry_id])
  @@index([seniority_level])
  @@map("jobs")
}

model Skill {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  serialNumber        String           @unique
  type                String?
  category            SkillCategory?
  categories          String[]
  description         String?
  icon_url            String?
  industry_id         String?          @db.Uuid
  difficulty          DifficultyLevel?
  usedIn              String[]         @map("used_in")
  jobs                String[]
  productCategories   String[]         @map("product_categories")
