<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= organizationName %> - Card</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&display=swap');
        html, body { width: 500px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header-row { display: flex; align-items: center; border: 3px solid #396bb3; border-radius: 35px; padding: 8px 15px; margin-bottom: 12px; gap: 15px; background: #ffffff; }
        .maygraph-logo { display: flex; align-items: center; justify-content: center; width: 60px; height: 60px; border: 3px solid #396bb3; border-radius: 18px; box-sizing: border-box; background: #ffffff; padding: 4px; flex-shrink: 0; }
        .maygraph-logo img { width: 100%; height: 100%; object-fit: contain; }
        .company-title { font-family: 'Work Sans', sans-serif; font-size: 2.2rem; color: #090b28; font-weight: 700; margin: 0; text-align: left; }
        .type-primary { color: #104589; font-weight: 700; font-size: 1.25rem; text-align: center; margin: 10px 0px; }
        .info-table { display: flex; flex-direction: column; gap: 15px; padding: 0px 20px; }
        .info-row { display: flex; align-items: flex-start; gap: 14px; }
        .info-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-label { flex: 0 0 130px; font-size: 1.10rem; color: #555555; font-weight: 500; padding-top: 8px; }
        .info-value { flex: 1; text-align: left; color: #00448c; font-size: 1.12rem; font-weight: 500; word-break: break-word; line-height: 1.4; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 15px; margin-bottom: 2px; padding: 0px 20px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; font-weight: bold; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= organizationName %></div>
        </div>
        <% if (category) { %>
        <div class="type-primary"><%= category %></div>
        <% } %>
        <div class="info-table">
            <% if (industry) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Industry.png') %>" alt="" /></div>
                <div class="info-label">Industry</div>
                <div class="info-value"><%= industry %></div>
            </div>
            <% } %>
            <% if (companyType) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value" style="padding-top: 8px;"><%= companyType %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'creation_date.png') %>" alt="" /></div>
                <div class="info-label">Founded</div>
                <div class="info-value" style="padding-top: 8px;"><%= founded %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'hq.png') %>" alt="" /></div>
                <div class="info-label">Headquarters</div>
                <div class="info-value" style="padding-top: 8px;"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (parent) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'parent_company.png') %>" alt="" /></div>
                <div class="info-label">Parent Company</div>
                <div class="info-value" style="padding-top: 8px;"><%= parent %></div>
            </div>
            <% } %>
            <% if (numberOfOffices) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'offices.png') %>" alt="" /></div>
                <div class="info-label">No. of offices</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfOffices %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">No. of employees</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (products) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'product.png') %>" alt="" /></div>
                <div class="info-label">Products</div>
                <div class="info-value"><%= products %></div>
            </div>
            <% } %>
            <% if (subsidiaries) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Subsidiaries.png') %>" alt="" /></div>
                <div class="info-label">Subsidiaries</div>
                <div class="info-value"><%= subsidiaries %></div>
            </div>
            <% } %>
            <% if (knownFor) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Known for</div>
                <div class="info-value"><%= knownFor %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serialNumber %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
