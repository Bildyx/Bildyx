<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="css/organization-card.css">
    <style>
        :root {
            --card-width: 700px;
            --theme-color: #3565ae;
            --primary-type-color: #1b52a4;
            --label-width: 170px;
            --value-color: #1b52a4;
        }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= name %></div>
        </div>
        <div class="info-table">
            <% if (description) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Description</div>
                <div class="info-value"><%= description %></div>
            </div>
            <% } %>
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value"><%= type1 %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'creation_date.png') %>" alt="" /></div>
                <div class="info-label">Established</div>
                <div class="info-value"><%= founded %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'capital.png') %>" alt="" /></div>
                <div class="info-label">Capital</div>
                <div class="info-value"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">Employees</div>
                <div class="info-value"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (subsidiaries) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'government.png') %>" alt="" /></div>
                <div class="info-label">Child Agencies</div>
                <div class="info-value"><%= subsidiaries %></div>
            </div>
            <% } %>
            <% if (known_for) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Known for/Impact</div>
                <div class="info-value"><%= known_for %></div>
            </div>
            <% } %>
            <% if (budget) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'currency.png') %>" alt="" /></div>
                <div class="info-label">Budget</div>
                <div class="info-value"><%= budget %></div>
            </div>
            <% } %>
            <% if (programs_activities) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'life_quality.png') %>" alt="" /></div>
                <div class="info-label">Functions/Programs</div>
                <div class="info-value"><%= programs_activities %></div>
            </div>
            <% } %>
            <% if (jurisdiction) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'monument.png') %>" alt="" /></div>
                <div class="info-label">Jurisdiction</div>
                <div class="info-value"><%= jurisdiction %></div>
            </div>
            <% } %>
            <% if (founders) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'founder.png') %>" alt="" /></div>
                <div class="info-label">Preceding Agency</div>
                <div class="info-value"><%= founders %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serial_number %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
