<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= name %></div>
        </div>
        <div class="info-table">
            <% if (description) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Description</div>
                <div class="info-value"><%= description %></div>
            </div>
            <% } %>
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value" style="padding-top: 8px;"><%= type1 %></div>
            </div>
            <% } %>
            <% if (industry) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Industry.png') %>" alt="" /></div>
                <div class="info-label">Industry</div>
                <div class="info-value"><%= industry %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'monument.png') %>" alt="" /></div>
                <div class="info-label">Established</div>
                <div class="info-value" style="padding-top: 8px;"><%= founded %></div>
            </div>
            <% } %>
            <% if (type2) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'monument.png') %>" alt="" /></div>
                <div class="info-label">Ownership</div>
                <div class="info-value" style="padding-top: 8px;"><%= type2 %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'hq.png') %>" alt="" /></div>
                <div class="info-label">Headquarters</div>
                <div class="info-value" style="padding-top: 8px;"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (parent) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'parent_company.png') %>" alt="" /></div>
                <div class="info-label">Parent</div>
                <div class="info-value" style="padding-top: 8px;"><%= parent %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">Employees</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (subsidiaries) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'parent_company.png') %>" alt="" /></div>
                <div class="info-label">Subsidiaries</div>
                <div class="info-value" style="padding-top: 8px;"><%= subsidiaries %></div>
            </div>
            <% } %>
            <% if (budget) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'currency.png') %>" alt="" /></div>
                <div class="info-label">Budget</div>
                <div class="info-value" style="padding-top: 8px;"><%= budget %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serial_number %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
