<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= name %></div>
        </div>
        <div class="info-table">
            <% if (description) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Description</div>
                <div class="info-value"><%= description %></div>
            </div>
            <% } %>
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value" style="padding-top: 8px;"><%= type1 %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'creation_date.png') %>" alt="" /></div>
                <div class="info-label">Established</div>
                <div class="info-value" style="padding-top: 8px;"><%= founded %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'hq.png') %>" alt="" /></div>
                <div class="info-label">Headquarters</div>
                <div class="info-value" style="padding-top: 8px;"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">Staff</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (subsidiaries) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Subsidiaries.png') %>" alt="" /></div>
                <div class="info-label">Departments Overseen</div>
                <div class="info-value" style="padding-top: 8px;"><%= subsidiaries %></div>
            </div>
            <% } %>
            <% if (jurisdiction) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'globe.png') %>" alt="" /></div>
                <div class="info-label">Jurisdiction</div>
                <div class="info-value" style="padding-top: 8px;"><%= jurisdiction %></div>
            </div>
            <% } %>
            <% if (authority) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'authority.png') %>" alt="" /></div>
                <div class="info-label">Budget Authority</div>
                <div class="info-value" style="padding-top: 8px;"><%= authority %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serial_number %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
