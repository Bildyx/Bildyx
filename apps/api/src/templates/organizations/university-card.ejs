<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= name %></div>
        </div>
        <div class="info-table">
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value" style="padding-top: 8px;"><%= type1 %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'creation_date.png') %>" alt="" /></div>
                <div class="info-label">Established</div>
                <div class="info-value" style="padding-top: 8px;"><%= founded %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'location.png') %>" alt="" /></div>
                <div class="info-label">Location</div>
                <div class="info-value" style="padding-top: 8px;"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">Staff</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (known_for) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Known For/Impact</div>
                <div class="info-value"><%= known_for %></div>
            </div>
            <% } %>
            <% if (members) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'mortarboard.png') %>" alt="" /></div>
                <div class="info-label">Students</div>
                <div class="info-value" style="padding-top: 8px;"><%= members %></div>
            </div>
            <% } %>
            <% if (undergraduates) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'under_study.png') %>" alt="" /></div>
                <div class="info-label">Undergraduate</div>
                <div class="info-value" style="padding-top: 8px;"><%= undergraduates %></div>
            </div>
            <% } %>
            <% if (postgraduates) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'certified_person.png') %>" alt="" /></div>
                <div class="info-label">Graduate</div>
                <div class="info-value" style="padding-top: 8px;"><%= postgraduates %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serial_number %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
