<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="/css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <%- renderHeader(name) %>
        <div class="info-table">
            <%- renderRow('Description', description) %>
            <%- renderRow('Established', founded) %>
            <%- renderRow('Headquarters', headquartersLocation) %>
            <%- renderRow('Employees', numberOfEmployees) %>
            <%- renderRow('Mission', mission) %>
            <%- renderRow('Funding Sources', budget) %>
            <%- renderRow('Founders', founders) %>
        </div>
        <%- renderFooter() %>
    </div>
</body>
</html>
