<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= name %></div>
        </div>
        <div class="info-table">
            <% if (description) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Description</div>
                <div class="info-value"><%= description %></div>
            </div>
            <% } %>
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value" style="padding-top: 8px;"><%= type1 %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'monument.png') %>" alt="" /></div>
                <div class="info-label">Founded</div>
                <div class="info-value" style="padding-top: 8px;"><%= founded %></div>
            </div>
            <% } %>
            <% if (headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'location.png') %>" alt="" /></div>
                <div class="info-label">Location</div>
                <div class="info-value" style="padding-top: 8px;"><%= headquartersLocation %></div>
            </div>
            <% } %>
            <% if (offices) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'offices.png') %>" alt="" /></div>
                <div class="info-label">Offices</div>
                <div class="info-value" style="padding-top: 8px;"><%= offices %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">Staff</div>
                <div class="info-value" style="padding-top: 8px;"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (known_for) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Known For/Impact</div>
                <div class="info-value"><%= known_for %></div>
            </div>
            <% } %>
            <% if (budget) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'currency.png') %>" alt="" /></div>
                <div class="info-label">Funding Sources</div>
                <div class="info-value" style="padding-top: 8px;"><%= budget %></div>
            </div>
            <% } %>
            <% if (partners) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'group.png') %>" alt="" /></div>
                <div class="info-label">Partners</div>
                <div class="info-value" style="padding-top: 8px;"><%= partners %></div>
            </div>
            <% } %>
            <% if (mission) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'goal.png') %>" alt="" /></div>
                <div class="info-label">Mission</div>
                <div class="info-value" style="padding-top: 8px;"><%= mission %></div>
            </div>
            <% } %>
            <% if (programs_activities) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'tasks.png') %>" alt="" /></div>
                <div class="info-label">Programs/Project</div>
                <div class="info-value" style="padding-top: 8px;"><%= programs_activities %></div>
            </div>
            <% } %>
            <% if (members) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'certified_person.png') %>" alt="" /></div>
                <div class="info-label">Volunteers</div>
                <div class="info-value" style="padding-top: 8px;"><%= members %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serial_number %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
