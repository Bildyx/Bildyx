<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= name %> - Card</title>
    <link rel="stylesheet" href="/css/organization-card.css">
</head>
<body>
    <div class="main-card">
        <%- renderHeader(name) %>
        <div class="info-table">
            <%- renderRow('Description', description) %>
            <%- renderRow('Established', founded) %>
            <%- renderRow('Location', headquartersLocation) %>
            <%- renderRow('Part of', parent) %>
            <%- renderRow('Services', products) %>
            <%- renderRow('Sending Country', country) %>
            <%- renderRow('Host Country', jurisdiction) %>
        </div>
        <%- renderFooter() %>
    </div>
</body>
</html>
