<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= cityName %> - Card</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&display=swap');
        html, body { width: 1300px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 5px solid #396bb3; border-radius: 60px; padding: 40px 40px 34px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 5px solid #396bb3; pointer-events: none; }
        .header { display: flex; align-items: center; justify-content: center; border: 3px solid #396bb3; border-radius: 35px; padding: 15px 25px; margin-bottom: 25px; gap: 20px; background: #ffffff; width: 100%; box-sizing: border-box; }
        .maygraph-logo { display: flex; align-items: center; justify-content: center; width: 100px; height: 100px; border: 3px solid #396bb3; border-radius: 25px; box-sizing: border-box; background: #ffffff; padding: 6px; flex-shrink: 0; }
        .maygraph-logo img { width: 100%; height: 100%; object-fit: contain; }
        .city-header-title { font-family: 'Work Sans', sans-serif; font-size: 3.5rem; font-weight: 700; color: #090b28; text-align: left; flex-grow: 1; margin: 0; }
        .columns { display: flex; flex-direction: row; gap: 20px; margin-top: 5px; padding: 10px; }
        .col { flex: 1 1 0; display: flex; flex-direction: column; gap: 20px; min-width: 0; }
        .middle-col { justify-content: center; }
        .section { padding: 0px 15px 12px 15px; background: #f7fbff; border-radius: 34px; border: 3px solid #396bb3; }
        .section-title { font-size: 1.3rem; color: #f7fbff; letter-spacing: 0.5px; background: #396bb3; padding: 7px 22px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; margin: 0 -16px 16px -16px; text-align: center; display: inline-block; font-weight: bold; text-transform: uppercase; }
        .section-title-center { display: flex; justify-content: center; }
        .info-block { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 12px; }
        .info-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
        .info-icon img { width: 36px; height: 36px; object-fit: contain; }
        .info-label { color: #555555; font-size: 1.1rem; font-weight: 700; flex: 0 0 130px; padding-top: 6px; }
        .info-value { color: #00448c; font-size: 1.12rem; font-weight: 500; flex: 1; text-align: left; word-break: break-word; line-height: 1.4; }
        .fact-block { background: #e5f1ff; border-radius: 16px; padding: 12px 15px; display: flex; align-items: flex-start; gap: 12px; margin-bottom: 8px; border: 2px solid #396bb3; }
        .fact-value { color: #104589; font-size: 1.08rem; line-height: 1.4; font-weight: 500; }
        .people-desc { color: #090b28; font-style: italic; font-size: 1.06rem; margin: 20px 0px 10px 0px; opacity: 0.9; text-align: center; line-height: 1.4; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 15px; padding: 0px 20px; font-size: 1.4rem; font-weight: bold; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; }
        .copyright { margin-left: auto; color: #1d1d1b; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <h1 class="city-header-title"><%= cityName %></h1>
        </div>
        <div class="columns">
            <!-- LEFT COLUMN -->
            <div class="col">
                <% if (population) { %>
                <div class="section">
                    <div class="section-title-center"><div class="section-title">General</div></div>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'population.png') %>" alt="" /></span>
                        <span class="info-label">Population</span>
                        <span class="info-value" style="padding-top: 6px;"><%= population %></span>
                    </div>
                </div>
                <% } %>
                <div class="section">
                    <div class="section-title-center"><div class="section-title">Economy &amp; Career</div></div>
                    <% if (mainIndustries) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'Industry.png') %>" alt="" /></span>
                        <span class="info-label">Main Industries</span>
                        <span class="info-value"><%= mainIndustries %></span>
                    </div>
                    <% } %>
                    <% if (numberOfMultinationalHQs) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'hq.png') %>" alt="" /></span>
                        <span class="info-label">Multinational HQs</span>
                        <span class="info-value" style="padding-top: 6px;"><%= numberOfMultinationalHQs %></span>
                    </div>
                    <% } %>
                    <% if (numberOfAirports) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'airport.png') %>" alt="" /></span>
                        <span class="info-label">No. of Airports</span>
                        <span class="info-value" style="padding-top: 6px;"><%= numberOfAirports %></span>
                    </div>
                    <% } %>
                    <% if (largestCompanies) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'company.png') %>" alt="" /></span>
                        <span class="info-label">Largest Companies</span>
                        <span class="info-value"><%= largestCompanies %></span>
                    </div>
                    <% } %>
                </div>
            </div>
            <!-- MIDDLE COLUMN -->
            <div class="col middle-col">
                <div class="section">
                    <div class="section-title-center"><div class="section-title">Housing &amp; Income</div></div>
                    <% if (medianSalary) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'salary_evolution.png') %>" alt="" /></span>
                        <span class="info-label">Median Salary</span>
                        <span class="info-value" style="padding-top: 6px;"><%= medianSalary %></span>
                    </div>
                    <% } %>
                    <% if (costOfLiving) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'living_cost.png') %>" alt="" /></span>
                        <span class="info-label">Cost of Living</span>
                        <span class="info-value" style="padding-top: 6px;"><%= costOfLiving %></span>
                    </div>
                    <% } %>
                    <% if (medianHomePrice) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'home_price.png') %>" alt="" /></span>
                        <span class="info-label">Median Home Price</span>
                        <span class="info-value" style="padding-top: 6px;"><%= medianHomePrice %></span>
                    </div>
                    <% } %>
                    <% if (averageRent) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'rent.png') %>" alt="" /></span>
                        <span class="info-label">Average Rent</span>
                        <span class="info-value" style="padding-top: 6px;"><%= averageRent %></span>
                    </div>
                    <% } %>
                </div>
                <div class="section">
                    <div class="section-title-center"><div class="section-title">Weather</div></div>
                    <% if (temperatures) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'temperature.png') %>" alt="" /></span>
                        <span class="info-label">Temperatures</span>
                        <span class="info-value" style="padding-top: 6px;"><%= temperatures %></span>
                    </div>
                    <% } %>
                    <% if (climate) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'weather.png') %>" alt="" /></span>
                        <span class="info-label">Climate</span>
                        <span class="info-value" style="padding-top: 6px;"><%= climate %></span>
                    </div>
                    <% } %>
                </div>
                <% if (interestingFact) { %>
                <div class="section">
                    <div class="section-title-center"><div class="section-title">Interesting fact</div></div>
                    <div class="fact-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" style="width: 28px; height: 28px;" /></span>
                        <div class="fact-value"><%= interestingFact %></div>
                    </div>
                </div>
                <% } %>
            </div>
            <!-- RIGHT COLUMN -->
            <div class="col">
                <div class="section">
                    <div class="section-title-center"><div class="section-title">Education</div></div>
                    <% if (degreeHolders) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'mortarboard.png') %>" alt="" /></span>
                        <span class="info-label">Degree Holders</span>
                        <span class="info-value" style="padding-top: 6px;"><%= degreeHolders %></span>
                    </div>
                    <% } %>
                    <% if (numberOfCollegesAndUniversities) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'university.png') %>" alt="" /></span>
                        <span class="info-label">Colleges &amp; Univ.</span>
                        <span class="info-value" style="padding-top: 6px;"><%= numberOfCollegesAndUniversities %></span>
                    </div>
                    <% } %>
                    <% if (topUniversities) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'top_university.png') %>" alt="" /></span>
                        <span class="info-label">Top Univ.</span>
                        <span class="info-value"><%= topUniversities %></span>
                    </div>
                    <% } %>
                </div>
                <div class="section">
                    <div class="section-title-center"><div class="section-title">People</div></div>
                    <% if (numberOfNationalities) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'nationality.png') %>" alt="" /></span>
                        <span class="info-label">Nationalities</span>
                        <span class="info-value" style="padding-top: 6px;"><%= numberOfNationalities %></span>
                    </div>
                    <% } %>
                    <% if (languages) { %>
                    <div class="info-block">
                        <span class="info-icon"><img src="<%= getIcon('icons', 'language.png') %>" alt="" /></span>
                        <span class="info-label">Languages</span>
                        <span class="info-value" style="padding-top: 6px;"><%= languages %></span>
                    </div>
                    <% } %>
                    <% if (peopleDescription) { %>
                    <div class="people-desc">"<%= peopleDescription %>"</div>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serialNumber %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
