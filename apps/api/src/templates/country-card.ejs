<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= countryName %> - Card</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');
        
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        body {
            width: 100%;
            max-width: 1450px;
            margin: 0 auto;
            padding: 10px;
        }

        .main-card {
            width: 100%;
            background: #ffffff;
            border: 3px solid #3565ae;
            border-radius: 35px;
            padding: 22px 24px 14px 24px;
            position: relative;
        }

        .main-card::after {
            content: "";
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            bottom: 10px;
            border-radius: 26px;
            border: 3px solid #3565ae;
            pointer-events: none;
        }

        .header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
            position: relative;
            z-index: 2;
        }

        .maygraph-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 85px;
            height: 85px;
            border: 3px solid #3565ae;
            border-radius: 22px;
            background: #ffffff;
            padding: 6px;
            flex-shrink: 0;
        }
        .maygraph-logo img { width: 100%; height: 100%; object-fit: contain; }

        .card-banner {
            flex: 1;
            max-width: 660px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 80px;
            border: 3px solid #3565ae;
            border-radius: 40px;
            background: #ffffff;
            overflow: hidden;
            position: relative;
        }

        .banner-flag {
            width: 155px;
            height: 100%;
            overflow: hidden;
            flex-shrink: 0;
            clip-path: polygon(0 0, 100% 0, 75% 100%, 0 100%);
        }
        .banner-flag img { width: 100%; height: 100%; object-fit: cover; }

        .card-title {
            font-family: 'Work Sans', sans-serif;
            font-size: 2.7rem;
            color: #0b132b;
            font-weight: 700;
            margin: 0;
            text-align: center;
            flex: 1;
            padding: 0 15px;
            letter-spacing: -0.5px;
        }

        .banner-photo {
            width: 165px;
            height: 100%;
            overflow: hidden;
            flex-shrink: 0;
            clip-path: polygon(25% 0, 100% 0, 100% 100%, 0 100%);
        }
        .banner-photo img { width: 100%; height: 100%; object-fit: cover; }

        /* Grid */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            position: relative;
            z-index: 2;
            align-items: stretch;
        }

        .grid-column {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .section-box:last-child {
            flex-grow: 1;
        }

        @media (max-width: 1200px) {
            .card-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .card-grid {
                grid-template-columns: 1fr;
            }
            .header-row {
                flex-direction: column;
                align-items: center;
                gap: 15px;
            }
            .card-banner {
                max-width: 100%;
                width: 100%;
            }
        }

        /* Section Box */
        .section-box {
            border: 3px solid #3565ae;
            border-radius: 22px;
            background: #ffffff;
            padding: 20px 14px 10px 14px;
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .box-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: #3565ae;
            color: #ffffff;
            border-radius: 15px;
            padding: 3px 22px;
            font-weight: 700;
            font-size: 0.98rem;
            white-space: nowrap;
        }

        /* Row inside Box */
        .info-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .row-icon {
            width: 28px;
            height: 28px;
            object-fit: contain;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .row-label {
            width: 125px;
            flex-shrink: 0;
            color: #475569;
            font-weight: 500;
            font-size: 0.88rem;
            line-height: 1.25;
        }

        .row-value {
            flex: 1;
            color: #034287;
            font-weight: 500;
            font-size: 0.88rem;
            line-height: 1.3;
            word-break: break-word;
        }

        /* Fact Pill */
        .fact-pill {
            background: #eef5fc;
            border-radius: 16px;
            padding: 14px 12px;
            color: #034287;
            text-align: center;
            font-size: 0.88rem;
            font-weight: 500;
            line-height: 1.35;
        }

        /* Sub topic */
        .sub-topic {
            display: flex;
            flex-direction: column;
            gap: 3px;
            margin-bottom: 4px;
        }
        .sub-topic-title {
            color: #034287;
            text-decoration: underline;
            font-weight: 500;
            font-size: 0.88rem;
        }
        .sub-topic-value {
            color: #034287;
            font-size: 0.88rem;
            font-weight: 500;
            padding-left: 2px;
        }
        .arrow {
            color: #3565ae;
            font-weight: bold;
            margin-right: 4px;
        }

        /* Map silhouette */
        .country-map-center {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2px 0;
            margin: -4px 0;
        }
        .country-map-img {
            height: 90px;
            max-width: 130px;
            object-fit: contain;
            filter: invert(27%) sepia(85%) saturate(1250%) hue-rotate(200deg) brightness(85%) contrast(95%);
        }

        /* Quote */
        .people-quote {
            font-style: italic;
            font-size: 0.82rem;
            color: #475569;
            text-align: center;
            margin-top: 4px;
            padding: 0 4px;
            line-height: 1.3;
        }

        /* Footer */
        .footer-row {
            display: flex;
            justify-content: flex-end;
            margin-top: 10px;
            position: relative;
            z-index: 2;
        }
        .copyright {
            font-weight: 700;
            font-size: 1.3rem;
            color: #000000;
        }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="card-banner">
                <% if (flagUrl) { %>
                <div class="banner-flag">
                    <img src="<%= flagUrl %>" alt="<%= countryName %> Flag" />
                </div>
                <% } %>
                <div class="card-title"><%= countryName %></div>
                <% if (photoUrl) { %>
                <div class="banner-photo">
                    <img src="<%= photoUrl %>" alt="<%= countryName %> Landmark" />
                </div>
                <% } %>
            </div>
        </div>

        <div class="card-grid">
            <!-- LEFT COLUMN -->
            <div class="grid-column">
                <!-- GENERAL BOX -->
                <div class="section-box">
                    <div class="box-badge">General</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'capital.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Capital</div>
                        <div class="row-value"><%= capital || 'Paris' %></div>
                    </div>
                    <% if (mainCities) { %>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'main_city.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Main Cities</div>
                        <div class="row-value"><%= mainCities %></div>
                    </div>
                    <% } else { %>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'main_city.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Main Cities</div>
                        <div class="row-value">Marseille, Lyon, Toulouse, Nice</div>
                    </div>
                    <% } %>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'population.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Population</div>
                        <div class="row-value"><%= population || '68 million (Foreign Born: ~8.5 million)' %></div>
                    </div>
                </div>

                <!-- INTERESTING FACT BOX -->
                <div class="section-box">
                    <div class="box-badge">Interesting fact</div>
                    <div class="fact-pill">
                        <%= interestingFact || 'Famous for cuisine, art, and landmarks' %>
                    </div>
                </div>

                <!-- WORK AND LIFE BOX -->
                <div class="section-box">
                    <div class="box-badge">Work and Life</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'life_quality.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Quality Of Life</div>
                        <div class="row-value"><%= qualityOfLife || 'Very High' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'temperature.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Temperature</div>
                        <div class="row-value"><%= temperatures || '-5°C to 35°C' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'weather.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Climate</div>
                        <div class="row-value"><%= climate || 'Mostly temperate; Mediterranean in south' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'crime_rate.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Crime Rate</div>
                        <div class="row-value"><%= crimeRate || 'Moderate to low' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'income_inequality.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Income Inequality</div>
                        <div class="row-value"><%= incomeInequality || 'Moderate' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'work_life_balance.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Work Life Balance</div>
                        <div class="row-value"><%= workLifeBalance || 'Strong labor protections; good balance with cultural emphasis on leisure' %></div>
                    </div>
                </div>
            </div>

            <!-- MIDDLE COLUMN -->
            <div class="grid-column">
                <!-- ECONOMY AND CAREER BOX -->
                <div class="section-box">
                    <div class="box-badge">Economy and career</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'currency.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Currency</div>
                        <div class="row-value"><%= currency || 'Euro (EUR)' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'Industry.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Main Industries</div>
                        <div class="row-value"><%= mainIndustries || 'Aerospace, Automotive, Pharmaceuticals, Luxury Goods, Finance, Agriculture' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'company.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Largest Companies</div>
                        <div class="row-value"><%= largestCompanies || 'TotalEnergies, L\'Oréal, Airbus, BNP Paribas, Renault' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'hq.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No of Multinational HQs</div>
                        <div class="row-value"><%= numberOfMultinationalHQs || '1,000+' %></div>
                    </div>
                </div>

                <!-- HOUSING & INCOME BOX -->
                <div class="section-box">
                    <div class="box-badge">Housing &amp; Income</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'salary_evolution.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Median Annual Salary</div>
                        <div class="row-value"><%= medianSalary || '~€45,000' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'tax.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Personal Income Tax</div>
                        <div class="row-value"><%= personalIncomeTax || '0–45% (progressive)' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'living_cost.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Cost of Living</div>
                        <div class="row-value"><%= costOfLiving || 'High' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'home_price.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Median Home Price</div>
                        <div class="row-value"><%= medianHomePrice || '~€350,000' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'rent.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Average Rent</div>
                        <div class="row-value"><%= averageRent || '~€1,200' %></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="grid-column">
                <!-- SILHOUETTE MAP -->
                <% if (mapUrl) { %>
                <div class="country-map-center">
                    <img src="<%= mapUrl %>" class="country-map-img" alt="<%= countryName %> Map" />
                </div>
                <% } %>

                <!-- IMMIGRATION BOX -->
                <div class="section-box">
                    <div class="box-badge">Immigration</div>
                    <div class="sub-topic">
                        <div class="sub-topic-title">How easy it is to get citizenship?</div>
                        <div class="sub-topic-value"><span class="arrow">&#10141;</span> <%= citizenshipProcess || 'Requires 5 years of residency' %></div>
                    </div>
                    <div class="sub-topic">
                        <div class="sub-topic-title">How easy it is to get work permit?</div>
                        <div class="sub-topic-value"><span class="arrow">&#10141;</span> <%= workPermit || 'Moderate difficulty; EU nationals have easier access' %></div>
                    </div>
                </div>

                                <!-- GLOBALIZATION BOX -->
                <div class="section-box">
                    <div class="box-badge">Globalization</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'global_index.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Global Competitiveness Index</div>
                        <div class="row-value"><%= globalCompetitivenessIndex || '20' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'globalization_level.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Level of Globalization</div>
                        <div class="row-value"><%= levelOfGlobalization || 'Highly globalized' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'international_student.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No. of International Students</div>
                        <div class="row-value"><%= numberOfInternationalStudents || '~300,000' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'foreign_company.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No. of Foreign Companies That Have Office</div>
                        <div class="row-value"><%= numberOfForeignCompaniesThatHaveOffice || '~12,000' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'tourist.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No. of Tourists</div>
                        <div class="row-value"><%= numberOfTourists || '~89 million' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'airport.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No. of Airports</div>
                        <div class="row-value"><%= numberOfAirports || '160+' %></div>
                    </div>
                </div>
            </div>

            <div class="grid-column">
                                <!-- EDUCATION BOX -->
                <div class="section-box">
                    <div class="box-badge">Education</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'open_book.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Quality of Primary and Secondary Education</div>
                        <div class="row-value"><%= qualityOfPrimaryAndSecondaryEducation || 'Excellent' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'mortarboard.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Degree Holders</div>
                        <div class="row-value"><%= degreeHolders || "35% Bachelor's, 15% Master's, 2% PhD" %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'university.png') %>" class="row-icon" alt="" />
                        <div class="row-label">No. of Colleges and Universities</div>
                        <div class="row-value"><%= numberOfCollegesAndUniversities || '80+' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'top_university.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Top Univ.</div>
                        <div class="row-value"><%= topUniversities || 'Sorbonne University, University of Paris, École Polytechnique, Sciences Po' %></div>
                    </div>
                </div>

                <!-- PEOPLE BOX -->
                <div class="section-box">
                    <div class="box-badge">People</div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'group.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Ethnic Groups</div>
                        <div class="row-value"><%= ethnicGroups || 'French, North Africans, Sub-Saharan Africans' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'language.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Languages</div>
                        <div class="row-value"><%= languages || 'French (official), regional languages' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'religion.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Religion</div>
                        <div class="row-value"><%= religion || 'Christianity (mostly Catholic), Islam, secularism' %></div>
                    </div>
                    <div class="info-row">
                        <img src="<%= getIcon('icons', 'values.png') %>" class="row-icon" alt="" />
                        <div class="row-label">Cultural Values</div>
                        <div class="row-value"><%= culturalValues || 'Liberty, equality, fraternity, cultural pride' %></div>
                    </div>
                    <div class="people-quote">
                        &ldquo;<%= peopleDescription || 'French people are known for their cultural sophistication, strong regional identities, and love for cuisine and arts.' %>&rdquo;
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-row">
            <span class="copyright">&copy;<%= year %></span>
        </div>
    </div>
</body>
</html>
