<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= organizationName %> - Card</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap');
        html, body { width: 700px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #ffffff; border: 3px solid #3565ae; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #3565ae; pointer-events: none; }
        .header-row { display: flex; align-items: center; border: 3px solid #3565ae; border-radius: 35px; padding: 8px 15px; margin-bottom: 12px; gap: 15px; background: #ffffff; }
        .maygraph-logo { display: flex; align-items: center; justify-content: center; width: 60px; height: 60px; border: 3px solid #3565ae; border-radius: 18px; box-sizing: border-box; background: #ffffff; padding: 4px; flex-shrink: 0; }
        .maygraph-logo img { width: 100%; height: 100%; object-fit: contain; }
        .company-title { font-family: 'Work Sans', sans-serif; font-size: 2.1rem; color: #000000; font-weight: 700; margin: 0; text-align: left; line-height: 1.2; }
        .type-primary { color: #1b52a4; font-weight: 700; font-size: 1.35rem; text-align: center; margin: 10px 0px 18px 0px; }
        .info-table { display: flex; flex-direction: column; gap: 16px; padding: 0px 15px; }
        .info-row { display: flex; align-items: flex-start; gap: 14px; }
        .info-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-label { flex: 0 0 170px; font-size: 1.10rem; color: #333333; font-weight: 600; padding-top: 8px; }
        .info-value { flex: 1; text-align: left; color: #1b52a4; font-size: 1.12rem; font-weight: 500; word-break: break-word; line-height: 1.4; padding-top: 8px; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 22px; margin-bottom: 2px; padding: 0px 15px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; font-weight: bold; font-size: 1.05rem; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; font-size: 1.05rem; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="company-title"><%= organizationName %></div>
        </div>
        <div class="type-primary"><%= (category === "Government" && organizationName === "United States Government") ? "Federal Government" : category %></div>
        <div class="info-table">
            <% if (type1) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Type.png') %>" alt="" /></div>
                <div class="info-label">Type</div>
                <div class="info-value"><%= type1 %></div>
            </div>
            <% } %>
            <% if (founded) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'creation_date.png') %>" alt="" /></div>
                <div class="info-label">Established</div>
                <div class="info-value"><%= founded %></div>
            </div>
            <% } %>
            <% if (cityName || headquartersLocation) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'capital.png') %>" alt="" /></div>
                <div class="info-label">Capital</div>
                <div class="info-value"><%= cityName || headquartersLocation %></div>
            </div>
            <% } %>
            <% if (numberOfEmployees) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'employees.png') %>" alt="" /></div>
                <div class="info-label">No. of employees</div>
                <div class="info-value"><%= numberOfEmployees %></div>
            </div>
            <% } %>
            <% if (offices) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'monument.png') %>" alt="" /></div>
                <div class="info-label">Ministries/ Departments</div>
                <div class="info-value"><%= offices %></div>
            </div>
            <% } %>
            <% if (knownFor) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'notes.png') %>" alt="" /></div>
                <div class="info-label">Known for / Impact</div>
                <div class="info-value"><%= knownFor %></div>
            </div>
            <% } %>
            <% if (programsActivities) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'life_quality.png') %>" alt="" /></div>
                <div class="info-label">Functions / Programs</div>
                <div class="info-value"><%= programsActivities %></div>
            </div>
            <% } %>
            <% if (budget) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'currency.png') %>" alt="" /></div>
                <div class="info-label">Budget</div>
                <div class="info-value"><%= budget %></div>
            </div>
            <% } %>
            <% if (partners) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'parent_company.png') %>" alt="" /></div>
                <div class="info-label">Partners</div>
                <div class="info-value"><%= partners %></div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serialNumber %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
