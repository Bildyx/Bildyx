<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= serialNumber %> - Card</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&display=swap');
        html, body { width: 500px; margin: 0; padding: 0; font-family: 'Work Sans', Arial, sans-serif; background-color: transparent; }
        .main-card { width: 100%; background: #fdfdfd; border: 3px solid #396bb3; border-radius: 60px; padding: 35px 40px 35px 40px; box-sizing: border-box; display: flex; flex-direction: column; position: relative; }
        .main-card::after { content: ""; position: absolute; top: 20px; left: 25px; right: 25px; bottom: 20px; border-radius: 50px; border: 3px solid #396bb3; pointer-events: none; }
        .header-row { display: flex; align-items: center; border: 3px solid #396bb3; border-radius: 35px; padding: 8px 15px; margin-bottom: 15px; gap: 15px; background: #ffffff; }
        .maygraph-logo { display: flex; align-items: center; justify-content: center; width: 60px; height: 60px; border: 3px solid #396bb3; border-radius: 18px; box-sizing: border-box; background: #ffffff; padding: 4px; flex-shrink: 0; }
        .maygraph-logo img { width: 100%; height: 100%; object-fit: contain; }
        .skill-title { font-family: 'Work Sans', sans-serif; font-size: 2.0rem; color: #090b28; font-weight: 700; margin: 0; text-align: left; }
        .type-primary { color: #104589; font-weight: 700; font-size: 1.25rem; text-align: center; margin: 10px 0px; text-transform: uppercase; }
        .info-table { display: flex; flex-direction: column; gap: 15px; padding: 0px 20px; }
        .info-row { display: flex; align-items: flex-start; gap: 14px; }
        .info-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
        .info-icon img { width: 40px; height: 40px; object-fit: contain; }
        .info-block { display: flex; flex-direction: column; flex: 1; }
        .info-label { color: #555555; font-size: 1.10rem; font-weight: 700; margin-bottom: 4px; }
        .info-value { color: #00448c; font-size: 1.12rem; font-weight: 500; word-break: break-word; line-height: 1.4; }
        .footer-row { display: flex; justify-content: space-between; position: relative; margin-top: 20px; margin-bottom: 2px; padding: 0px 20px; }
        .serial-number { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: #1d1d1b; font-weight: bold; }
        .copyright { margin-left: auto; color: #1d1d1b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="header-row">
            <div class="maygraph-logo">
                <img src="<%= getIcon('logos', 'Logo-MayGraph_Big1.png') %>" alt="MayGraph" />
            </div>
            <div class="skill-title"><%= name %></div>
        </div>
        <% if (type) { %>
        <div class="type-primary"><%= type %></div>
        <% } %>
        <div class="info-table">
            <% if (skillCategories) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'skill_categorie.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Skill Categories</div>
                    <div class="info-value"><%= skillCategories %></div>
                </div>
            </div>
            <% } %>
            <% if (usedIn) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'used_in.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Used in</div>
                    <div class="info-value"><%= usedIn %></div>
                </div>
            </div>
            <% } %>
            <% if (jobOccupations) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'position.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Job Occupations</div>
                    <div class="info-value"><%= jobOccupations %></div>
                </div>
            </div>
            <% } %>
            <% if (industry) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'Industry.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Industry</div>
                    <div class="info-value"><%= industry %></div>
                </div>
            </div>
            <% } %>
            <% if (productCategory) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'product.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Product Category</div>
                    <div class="info-value"><%= productCategory %></div>
                </div>
            </div>
            <% } %>
            <% if (commonFieldsOfStudy) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'mortarboard.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Common Fields of Study</div>
                    <div class="info-value"><%= commonFieldsOfStudy %></div>
                </div>
            </div>
            <% } %>
            <% if (relatedAbilities) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'brain.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Related Abilities</div>
                    <div class="info-value"><%= relatedAbilities %></div>
                </div>
            </div>
            <% } %>
            <% if (timeToMasterIt) { %>
            <div class="info-row">
                <div class="info-icon"><img src="<%= getIcon('icons', 'hourglass.png') %>" alt="" /></div>
                <div class="info-block">
                    <div class="info-label">Time to master it</div>
                    <div class="info-value"><%= timeToMasterIt %></div>
                </div>
            </div>
            <% } %>
        </div>
        <div class="footer-row">
            <span class="serial-number">#<%= serialNumber %></span>
            <span class="copyright">©<%= year %></span>
        </div>
    </div>
</body>
</html>
