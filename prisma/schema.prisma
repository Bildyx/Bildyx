// =============================================================================
// LAYER 1 — TABLES DE RÉFÉRENCE (les "cartes")
// =============================================================================

/// Secteur d'activité
model Industry {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  serialNumber     String     @unique
  description      String?
  parentIndustryId String?    @map("parent_industry_id") @db.Uuid
  parentIndustry   Industry?  @relation("IndustryHierarchy", fields: [parentIndustryId], references: [id])
  childIndustries  Industry[] @relation("IndustryHierarchy")
  iconUrl          String?    @map("icon_url")
  color            String?
  medianSalary     Int?       @map("median_salary")
  metadata         Json? //?
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  jobs                  Job[]
  skills                Skill[]
  companies             Organization[] @relation("CompanyIndustries")
  products              Subject[]      @relation("ProductIndustries")
  facts                 Fact[]
  mainIndustryCountries Country[]      @relation("CountryMainIndustries")
  mainIndustryCities    City[]         @relation("CityMainIndustries")

  @@index([parentIndustryId])
  @@map("industries")
}

/// Pays
model Country {
  id                            String          @id @default(uuid()) @db.Uuid
  name                          String
  serialNumber                  String          @unique
  isoCode                       String?         @unique @map("iso_code") @db.Char(2)
  capitalName                   String?         @map("capital_name")
  flagUrl                       String?         @map("flag_url")
  population                    BigInt?
  areaKm2                       Float?          @map("area_km2")
  gdpUsd                        Float?          @map("gdp_usd")
  gdpPerCapitaUsd               Float?          @map("gdp_per_capita_usd")
  hdi                           Float?
  currency                      String?
  officialLanguages             Language[]
  callingCode                   String?         @map("calling_code")
  governmentType                GovernmentType? @map("government_type")
  qualityOfLife                 QualityOfLife?  @map("quality_of_life")
  temperatures                  String?
  climate                       String?
  crimeRate                     String?         @map("crime_rate")
  incomeInequality              String?         @map("income_inequality")
  workLifeBalance               String?         @map("work_life_balance")
  mainIndustries                Industry[]      @relation("CountryMainIndustries")
  largestCompanies              Organization[]  @relation("CountryLargestCompanies")
  numberOfMultinationalHqs      Int?            @map("number_of_multinational_hqs")
  medianSalary                  Int?            @map("median_salary")
  costOfLiving                  CostOfLiving?   @map("cost_of_living")
  medianHomePrice               Int?            @map("median_home_price")
  averageRent                   Int?            @map("average_rent")
  interestingFact               String?         @map("interesting_fact")
  citizenshipProcess            String?         @map("citizenship_process")
  workPermit                    String?         @map("work_permit")
  globalCompetitivenessIndex    Int?            @map("global_competitiveness_index")
  levelOfGlobalisation          String?         @map("level_of_globalisation")
  numberOfInternationalStudents Int?            @map("number_of_international_students")
  numberOfForeignCompanies      Int?            @map("number_of_foreign_companies")
  personalIncomeTax             String?         @map("personal_income_tax")
  numberOfTourists              Int?            @map("number_of_tourists")
  numberOfAirports              Int?            @map("number_of_airports")
  qualityOfEducation            String?         @map("quality_of_education")
  degreeHolders                 String?         @map("degree_holders")
  numberOfUniversities          Int?            @map("number_of_universities")
  topUniversities               University[]    @relation("CountryTopUniversities")
  ethnicGroups                  String[]        @map("ethnic_groups")
  religion                      String[]
  culturalValues                String?         @map("cultural_values")
  peopleDescription             String?         @map("people_description")
  metadata                      Json?
  deletedAt                     DateTime?       @map("deleted_at")
  createdAt                     DateTime        @default(now()) @map("created_at")
  updatedAt                     DateTime        @updatedAt @map("updated_at")

  cities       City[]
  jobs         Job[]
  jobOffers    JobOffer[]
  universities University[]
  facts        Fact[]
  userProfiles UserProfile[] @relation("UserProfileCountry")

  @@map("countries")
}

/// Ville
model City {
  id                       String        @id @default(uuid()) @db.Uuid
  name                     String
  serialNumber             String        @unique
  countryId                String        @map("country_id") @db.Uuid
  country                  Country       @relation(fields: [countryId], references: [id])
  region                   String?
  department               String?
  population               Int?
  mainIndustries           Industry[]    @relation("CityMainIndustries")
  numberOfMultinationalHqs Int?          @map("number_of_multinational_hqs")
  numberOfAirports         Int?          @map("number_of_airports")
  largestCompanies         Organization[] @relation("CityLargestCompanies")
  medianSalary             Int?          @map("median_salary")
  costOfLiving             CostOfLiving? @map("cost_of_living")
  medianHomePrice          Int?          @map("median_home_price")
  averageRent              Int?          @map("average_rent")
  temperatures             String?
  climate                  String?
  interestingFact          String?       @map("interesting_fact")
  degreeHolders            String?       @map("degree_holders")
  numberOfUniversities     Int?          @map("number_of_universities")
  topUniversities          University[]  @relation("CityTopUniversities")
  numberOfNationalities    Int?          @map("number_of_nationalities")
  language                 Language?
  peopleDescription        String?       @map("people_description")
  latitude                 Float?
  longitude                Float?
  metadata                 Json?
  deletedAt                DateTime?     @map("deleted_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  universities University[]
  jobOffers    JobOffer[]
  userProfiles UserProfile[]
  facts        Fact[]

  @@index([countryId])
  @@map("cities")
}

/// Entreprise / Organisation
model Organization {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String            @unique
  type                  OrganizationType?
  category              String?
  subsidiariesCount     Int?              @map("subsidiaries_count")
  legalStatus           String?           @map("legal_status")
  ownership             String?
  mission               String?
  purpose               String?
  focus                 String?
  focusAreas            String[]          @map("focus_areas")
  strategicFocus        String?           @map("strategic_focus")
  knownFor              String[]          @map("known_for")
  distinction           String?
  fields                String[]
  keyActivities         String[]          @map("key_activities")
  keyProject            String?           @map("key_project")
  keyResearchOutput     String?           @map("key_research_output")
  majorPrograms         String[]          @map("major_programs")
  majorProjects         String[]          @map("major_projects")
  researchAreas         String[]          @map("research_areas")
  researchModel         String?           @map("research_model")
  businessAndInnovation String?           @map("business_and_innovation")
  products              String[]
  services              String[]
  managementAndAdmin    String?           @map("management_and_admin")
  mainOrgan             String?           @map("main_organ")
  constituency          String?
  affiliation           String?
  collaborations        String[]
  partnerships          String[]
  fundingSources        String[]          @map("funding_sources")
  budget                String?
  endowment             String?
  gdp                   String?
  founded               String?
  formed                String?
  formation             String?
  opened                String?
  dissolved             String?
  founder               String?

  // --- Localisation ---
  headquarters     String?
  location         String?
  regionServed     String? @map("region_served")
  geography        String?
  totalLandArea    String? @map("total_land_area")
  populationOfCity String? @map("population_of_city")

  // --- Taille & Effectifs ---
  numberOfOffices              Int?    @map("number_of_offices")
  numberOfEmployees            Int?    @map("number_of_employees")
  numberOfMembers              Int?    @map("number_of_members")
  numberOfPersonnel            Int?    @map("number_of_personnel")
  numberOfVolunteers           Int?    @map("number_of_volunteers")
  numberOfGovernmentMinistries Int?    @map("number_of_government_ministries")
  numberOfMinistries           Int?    @map("number_of_ministries")
  scale                        String?
  size                         String?
  visitors                     String?

  // --- Installations & Structures ---
  labs                     String[]
  giantFacilities          String[] @map("giant_facilities")
  nationalParks            String[] @map("national_parks")
  librariesAndPublications String?  @map("libraries_and_publications")
  tacticalUnits            String[] @map("tactical_units")

  // --- Hiérarchie ---
  parentOrganizationId    String?        @map("parent_organization_id") @db.Uuid
  parentOrganization      Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childAgencies           Organization[] @relation("OrganizationHierarchy")
  parentBureau            String?        @map("parent_bureau")
  parentDepartment        String?        @map("parent_department")
  parentMinistry          String?        @map("parent_ministry")
  precedingAgency         String?        @map("preceding_agency")
  precedingBureau         String?        @map("preceding_bureau")
  precedingDepartment     String?        @map("preceding_department")
  supersedingAgencies     String[]       @map("superseding_agencies")
  supersedingPostalSystem String?        @map("superseding_postal_system")

  // --- Militaire : Marine ---
  numberOfActiveNavyPersonnel    Int? @map("number_of_active_navy_personnel")
  numberOfDestroyers             Int? @map("number_of_destroyers")
  numberOfSubmarinesDiesel       Int? @map("number_of_submarines_diesel")
  numberOfSubmarinesNuclear      Int? @map("number_of_submarines_nuclear")
  numberOfNavalShipyards         Int? @map("number_of_naval_shipyards")
  numberOfMaritimePatrolAircraft Int? @map("number_of_maritime_patrol_aircraft")
  numberOfStealthFleet           Int? @map("number_of_stealth_fleet")
  numberOfSurveillanceRadars     Int? @map("number_of_surveillance_radars")

  // --- Militaire : Aérien ---
  numberOfAircrafts       Int? @map("number_of_aircrafts")
  numberOfFighterJets     Int? @map("number_of_fighter_jets")
  numberOfHelicopters     Int? @map("number_of_helicopters")
  numberOfDrones          Int? @map("number_of_drones")
  numberOfTankerPlanes    Int? @map("number_of_tanker_planes")
  numberOfTransportPlanes Int? @map("number_of_transport_planes")

  // --- Spatial ---
  numberOfCommunicationSatellites  Int? @map("number_of_communication_satellites")
  numberOfMissileWarningSatellites Int? @map("number_of_missile_warning_satellites")
  numberOfNavigationSatellites     Int? @map("number_of_navigation_satellites")
  numberOfSpySatellites            Int? @map("number_of_spy_satellites")
  numberOfSatelliteJammingSystems  Int? @map("number_of_satellite_jamming_systems")
  numberOfSurveillanceTelescopes   Int? @map("number_of_surveillance_telescopes")
  numberOfOperationalSpaceplanes   Int? @map("number_of_operational_spaceplanes")
  numberOfSpaceLaunchSites         Int? @map("number_of_space_launch_sites")
  numberOfSpaceOperationsSquadrons Int? @map("number_of_space_operations_squadrons")
  numberOfSpacePersonnel           Int? @map("number_of_space_personnel")

  // --- Métadonnées ---
  metadata  Json?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // --- Relations ---
  industries              Industry[]      @relation("CompanyIndustries")
  subjects                Subject[]
  jobOffers               JobOffer[]
  issuedCertifications    Certification[] @relation("CertificationIssuer")
  facts                   Fact[]
  userProfiles            UserProfile[]   @relation("UserCurrentCompany")
  largestCompanyCountries Country[]       @relation("CountryLargestCompanies")
  largestCompanyCities    City[]          @relation("CityLargestCompanies")

  @@index([parentOrganizationId])
  @@index([type])
  @@map("organizations")
}

/// Métier
model Job {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  serialNumber   String          @unique
  category       JobCategory?
  description    String?
  seniorityLevel SeniorityLevel? @map("seniority_level")
  isElected      Boolean         @default(false) @map("is_elected")
  isRegulated    Boolean         @default(false) @map("is_regulated")
  startYear      Int?            @map("start_year")
  industryId     String?         @map("industry_id") @db.Uuid
  industry       Industry?       @relation(fields: [industryId], references: [id])
  countryId      String?         @map("country_id") @db.Uuid
  country        Country?        @relation(fields: [countryId], references: [id])
  products       String[]
  toolsAndTech   String[]        @map("tools_and_tech")
  tags           String[]
  metadata       Json?
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  jobOffers    JobOffer[]
  facts        Fact[]
  userProfiles UserProfile[] @relation("UserCurrentJob")

  @@index([industryId])
  @@index([countryId])
  @@index([category])
  @@index([seniorityLevel])
  @@map("jobs")
}

/// Compétence (technique, soft skill, langue, outil…)
model Skill {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  serialNumber  String           @unique
  type              String?
  category          SkillCategory?
  categories        String[]
  description       String?
  iconUrl           String?          @map("icon_url")
  industryId        String?          @map("industry_id") @db.Uuid
  industry          Industry?        @relation(fields: [industryId], references: [id])
  difficulty        DifficultyLevel?
  usedIn            String[]         @map("used_in")
  jobs              String[]
  productCategories String[]         @map("product_categories")
  commonFieldsOfStudy String[]       @map("common_fields_of_study")
  relatedAbilities  String[]         @map("related_abilities")
  timeToMaster      String?          @map("time_to_master")
  metadata          Json?
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  jobOfferSkills JobOfferSkill[]

  @@index([industryId])
  @@index([category])
  @@map("skills")
}

/// Certification
model Certification {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  serialNumber           String                 @unique
  issuingOrganizationId  String?                @map("issuing_organization_id") @db.Uuid
  issuingOrganization    Organization?          @relation("CertificationIssuer", fields: [issuingOrganizationId], references: [id])
  description            String?
  level                  String?
  category               CertificationCategory?
  products               String[]
  jobs                   String[]
  validityDurationMonths Int?                   @map("validity_duration_months")
  difficulty             DifficultyLevel?
  cost                   Float?
  costCurrency           String?                @map("cost_currency") @db.Char(3)
  websiteUrl             String?                @map("website_url")
  logoUrl                String?                @map("logo_url")
  recognitionLevel       RecognitionLevel?      @map("recognition_level")
  prerequisites          String[]
  metadata               Json?
  deletedAt              DateTime?              @map("deleted_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@index([issuingOrganizationId])
  @@index([category])
  @@map("certifications")
}

/// Université / Grande école / Institution académique
model University {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  serialNumber    String          @unique
  officialName    String?         @map("official_name")
  acronym         String?
  type            UniversityType?
  description     String?
  websiteUrl      String?         @map("website_url")
  logoUrl         String?         @map("logo_url")
  foundedYear     Int?            @map("founded_year")
  countryId       String?         @map("country_id") @db.Uuid
  country         Country?        @relation(fields: [countryId], references: [id])
  cityId          String?         @map("city_id") @db.Uuid
  city            City?           @relation(fields: [cityId], references: [id])
  isPublic        Boolean?        @map("is_public")
  acceptanceRate  Float?          @map("acceptance_rate")
  studentCount    Int?            @map("student_count")
  metadata        Json?
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  degrees          Degree[]
  facts            Fact[]
  topOfCities      City[]    @relation("CityTopUniversities")
  topOfCountries   Country[] @relation("CountryTopUniversities")
  undergraduates   Int?
  postgraduates    Int?

  @@index([countryId])
  @@index([cityId])
  @@index([type])
  @@map("universities")
}

/// Diplôme (relié à une université)
//? à voir pour ne pas juste faire des diplômes simples (liste) plutôt que les relier à des universités
model Degree {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  serialNumber          String       @unique
  universityId          String       @map("university_id") @db.Uuid
  university            University?   @relation(fields: [universityId], references: [id])
  level                 DegreeLevel?
  field                 String?
  durationYears         Float?       @map("duration_years")
  description           String?
  languageOfInstruction String?      @map("language_of_instruction")
  countryId             String?      @map("country_id") @db.Uuid
  tuitionCurrency       String?      @map("tuition_currency") @db.Char(3) //?
  metadata              Json?
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([universityId])
  @@index([level])
  @@map("degrees")
}

/// Produit / Service / Solution
model Subject {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  serialNumber     String           @unique
  type             String?
  description      String?
  shortDescription String?          @map("short_description")
  category         ProductCategory?
  competitors      String[]
  funFact          String?          @map("fun_fact")
  companyId        String?          @map("company_id") @db.Uuid
  company          Organization?    @relation(fields: [companyId], references: [id])
  websiteUrl       String?          @map("website_url")
  logoUrl          String?          @map("logo_url")
  pricingModel     PricingModel?    @map("pricing_model")
  priceFrom        Float?           @map("price_from")
  priceCurrency    String?          @map("price_currency") @db.Char(3)
  isDeprecated     Boolean          @default(false) @map("is_deprecated")
  launchYear       Int?             @map("launch_year")
  documentationUrl String?          @map("documentation_url")
  tags             String[]
  metadata         Json?
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  industries Industry[] @relation("ProductIndustries")
  facts      Fact[]

  @@index([companyId])
  @@index([category])
  @@map("products")
}

/// Fait d'information vérifiable (polymorphique via FK nullables)
model Fact {
  id                  String        @id @default(uuid()) @db.Uuid
  title               String
  serialNumber        String        @unique
  content             String?
  hashtags            String[]
  icon                String?
  category            FactCategory?
  sourceUrl           String?       @map("source_url") //?
  sourceTitle         String?       @map("source_title") //?
  publishedAt         DateTime?     @map("published_at") //?
  verifiedAt          DateTime?     @map("verified_at") //?
  relatedCountryId    String?       @map("related_country_id") @db.Uuid
  relatedCountry      Country?      @relation(fields: [relatedCountryId], references: [id])
  relatedCityId       String?       @map("related_city_id") @db.Uuid
  relatedCity         City?         @relation(fields: [relatedCityId], references: [id])
  relatedCompanyId    String?       @map("related_company_id") @db.Uuid
  relatedCompany      Organization? @relation(fields: [relatedCompanyId], references: [id])
  relatedIndustryId   String?       @map("related_industry_id") @db.Uuid
  relatedIndustry     Industry?     @relation(fields: [relatedIndustryId], references: [id])
  relatedJobId        String?       @map("related_job_id") @db.Uuid
  relatedJob          Job?          @relation(fields: [relatedJobId], references: [id])
  relatedUniversityId String?       @map("related_university_id") @db.Uuid
  relatedUniversity   University?   @relation(fields: [relatedUniversityId], references: [id])
  relatedProductId    String?       @map("related_product_id") @db.Uuid
  relatedProduct      Subject?      @relation(fields: [relatedProductId], references: [id])
  tags                String[]
  metadata            Json?
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([relatedCountryId])
  @@index([relatedCityId])
  @@index([relatedCompanyId])
  @@index([relatedIndustryId])
  @@index([relatedJobId])
  @@index([relatedUniversityId])
  @@index([relatedProductId])
  @@index([category])
  @@map("facts")
}

/// Offre d'emploi
model JobOffer {
  id                      String          @id @default(uuid()) @db.Uuid
  title                   String
  serialNumber            String          @unique
  companyId               String          @map("company_id") @db.Uuid
  company                 Organization    @relation(fields: [companyId], references: [id])
  jobId                   String?         @map("job_id") @db.Uuid
  job                     Job?            @relation(fields: [jobId], references: [id])
  description             String?
  status                  JobOfferStatus  @default(DRAFT)
  contractType            ContractType?   @map("contract_type")
  remote                  RemotePolicy?
  countryId               String?         @map("country_id") @db.Uuid
  country                 Country?        @relation(fields: [countryId], references: [id])
  cityId                  String?         @map("city_id") @db.Uuid
  city                    City?           @relation(fields: [cityId], references: [id])
  salaryMin               Int?            @map("salary_min")
  salaryMax               Int?            @map("salary_max") //? Maybe salaryRange ?
  salaryCurrency          String?         @map("salary_currency") @db.Char(3) //?
  requiredYearsExperience Int?            @map("required_years_experience")
  requiredEducationLevel  EducationLevel? @map("required_education_level") //? à relier avec degree éventuellement
  applicationUrl          String?         @map("application_url")
  applicationEmail        String?         @map("application_email")
  numberOfPositions       Int?            @map("number_of_positions") //?
  benefitsDescription     String?         @map("benefits_description") //?
  publishedAt             DateTime?       @map("published_at")
  expiresAt               DateTime?       @map("expires_at")
  tags                    String[]
  metadata                Json?
  deletedAt               DateTime?       @map("deleted_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  requiredSkills JobOfferSkill[]

  @@index([companyId])
  @@index([jobId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([contractType])
  @@index([remote])
  @@index([publishedAt])
  @@map("job_offers")
}

// --- Table de jonction M2M avec attributs ---

/// Compétence requise pour une offre d'emploi (avec niveau d'importance)
//? Est ce vraiment utile ? 
model JobOfferSkill {
  id         String          @id @default(uuid()) @db.Uuid
  jobOfferId String          @map("job_offer_id") @db.Uuid
  jobOffer   JobOffer        @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  skillId    String          @map("skill_id") @db.Uuid
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance @default(REQUIRED) //?

  @@unique([jobOfferId, skillId])
  @@index([skillId])
  @@map("job_offer_skills")
}

// =============================================================================
// COUCHE 2 — UTILISATEURS, AUTH & PROFILS
// =============================================================================

/// Utilisateur (authentification & identité)
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  emailVerified       Boolean    @default(false) @map("email_verified")
  passwordHash        String     @map("password_hash")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  displayName         String?    @map("display_name")
  avatarUrl           String?    @map("avatar_url")
  role                UserRole   @default(USER)
  status              UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  metadata            Json?
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sessions UserSession[]
  profile  UserProfile?

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Profil public user
model UserProfile {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @unique @map("user_id") @db.Uuid
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  biography           String?
  countryId           String?       @map("country_id") @db.Uuid
  country             Country?      @relation("UserProfileCountry", fields: [countryId], references: [id])
  cityId              String?       @map("city_id") @db.Uuid
  city                City?         @relation(fields: [cityId], references: [id])
  linkedinUrl         String?       @map("linkedin_url")
  githubUrl           String?       @map("github_url")
  websiteUrl          String?       @map("website_url")
  locale              String?    @default("fr")
  timezone            String?
  isPublic            Boolean       @default(true) @map("is_public")
  currentJobId        String?       @map("current_job_id") @db.Uuid
  currentJob          Job?          @relation("UserCurrentJob", fields: [currentJobId], references: [id])
  currentJobStartedAt DateTime?     @map("current_job_started_at")
  currentCompanyId    String?       @map("current_company_id") @db.Uuid
  currentCompany      Organization? @relation("UserCurrentCompany", fields: [currentCompanyId], references: [id])
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([cityId])
  @@index([currentJobId])
  @@index([currentCompanyId])
  @@map("user_profiles")
}

/// Journal d'audit des actions sensibles (auth, changements de rôle, etc.)
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
